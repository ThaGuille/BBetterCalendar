<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions, merged into the debug variant (never in release). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- u9 component gallery. exported=true ONLY here (debug manifest) so it can be opened with
             adb shell am start -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.debug.DebugGalleryActivity
             No intent filter: it never shows in the launcher. -->
        <activity
            android:name="com.example.bbettercalendar.debug.DebugGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar" />

        <!-- rediseno-proyectos u3: gallery of the Projects widgets (adb recording rp-widgets). Same rules as
             above: exported only in the debug manifest, no intent filter.
             adb shell am start -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.debug.DebugProjectsGalleryActivity -->
        <activity
            android:name="com.example.bbettercalendar.debug.DebugProjectsGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar" />

        <!-- mejora-visual u4: gallery page of the Canvas chart kit (adb recording mv-u4-charts). Same rules as
             above: exported only in the debug manifest, no intent filter.
             adb shell am start -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.debug.DebugChartsGalleryActivity -->
        <activity
            android:name="com.example.bbettercalendar.debug.DebugChartsGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar" />

        <!-- Notificaciones (parte C): avisos diarios disparados a mano. exported=true SOLO aquí, para
             que el shell de adb llegue al receiver; el disparo sin acción sólo se atiende con
             BuildConfig.DEBUG (ver DailyNudgeReceiver):
             adb shell am broadcast -f 32 -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.notifications.nudge.DailyNudgeReceiver (extras: nudge=morning|streak|evening|weekly, reset_state=true) -->
        <receiver
            android:name="com.example.bbettercalendar.notifications.nudge.DailyNudgeReceiver"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- rediseno-proyectos u13: aviso de empezar una tarea disparado a mano. exported=true SOLO aqui; el
             disparo sin accion solo se atiende con BuildConfig.DEBUG (ver TaskStartReceiver):
             adb shell am broadcast -f 32 -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.notifications.task.TaskStartReceiver, boolean extra debug_first_eligible = true -->
        <receiver
            android:name="com.example.bbettercalendar.notifications.task.TaskStartReceiver"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- rediseno-proyectos u6: gallery of the task pickers (adb recording rp-pickers). Same rules as above:
             exported only in the debug manifest, no intent filter.
             adb shell am start -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.debug.DebugPickersGalleryActivity -->
        <activity
            android:name="com.example.bbettercalendar.debug.DebugPickersGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar" />
    </application>
</manifest>
