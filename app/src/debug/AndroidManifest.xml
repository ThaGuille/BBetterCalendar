<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions, merged into the debug variant (never in release). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- u9 component gallery. exported=true ONLY here (debug manifest) so it can be opened with
             adb shell am start -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.debug.DebugGalleryActivity
             No intent filter: it never shows in the launcher. -->
        <activity
            android:name="com.example.bbettercalendar.debug.DebugGalleryActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar" />

        <!-- F2-u6: App Link de invitación https://bbetter-dbcda.web.app/i/<código>. Solo en debug hasta L.7
             (D-025: Hosting solo en el emulador; el assetlinks.json de firebase/hosting lleva el SHA-256 de
             debug). En el AVD la verificación no puede pasar: se aprueba a mano con
             adb shell pm set-app-links-user-selection (comando completo en firebase/README.md, «Invitaciones
             y Hosting»). Sin UI: guarda el código y relanza la app con el intent
             del launcher (nunca un VIEW sobre SplashActivity). taskAffinity vacío: no se mete en la tarea
             de la app, así el intent del launcher encuentra la tarea viva o crea una nueva. -->
        <activity
            android:name="com.example.bbettercalendar.ui.social.InviteLinkActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="bbetter-dbcda.web.app"
                    android:pathPrefix="/i/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
