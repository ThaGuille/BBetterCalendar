<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only page of the component gallery for the Canvas chart kit (plan mejora-visual u4), opened from
     DebugGalleryActivity or with
     adb shell am start -n io.github.thaguille.bbettercalendar/com.example.bbettercalendar.debug.DebugChartsGalleryActivity -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/galleryChartsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- No android:id on the include: it would shadow the ids of the merged children. -->
        <include layout="@layout/gallery_section_charts" />
    </LinearLayout>
</ScrollView>
