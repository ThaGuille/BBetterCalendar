<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only resources of DebugGalleryActivity (u9). Not shipped, not translated. -->
<resources>

    <style name="GalleryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_lg</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Micro.Bold</item>
        <item name="android:textColor">@color/bb_primary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="GalleryCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/spacing_md</item>
    </style>

    <!-- mejora-visual u4: chart cards of the gallery (gallery_section_charts.xml). -->
    <style name="GalleryChartTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Title</item>
    </style>

    <style name="GalleryChartLegend">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <!-- Lines of up to 3 items, added by ChartGallerySection.legend(). -->
        <item name="android:orientation">vertical</item>
    </style>

    <dimen name="gallery_spark_width">120dp</dimen>
    <dimen name="gallery_legend_dot">10dp</dimen>

    <string-array name="gallery_u3_segments" translatable="false">
        <item>Semana</item>
        <item>Mes</item>
        <item>Ano</item>
    </string-array>

    <string-array name="gallery_periods" translatable="false">
        <item>Week</item>
        <item>Month</item>
        <item>Year</item>
    </string-array>

    <string-array name="gallery_week_month" translatable="false">
        <item>Week</item>
        <item>Month</item>
    </string-array>

    <string-array name="gallery_entry_kinds" translatable="false">
        <item>Event</item>
        <item>Task</item>
        <item>Reminder</item>
    </string-array>
</resources>
