<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications + alarm permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 2: lectura de uso de apps (acceso especial; se concede en Ajustes -> Acceso a uso,
         no por diálogo en runtime). tools:ignore para que lint no marque ProtectedPermissions. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Visibilidad de paquetes (API 30+): para listar apps lanzables en el picker y resolver
         nombre/icono de los paquetes que devuelve UsageStatsManager. Visibilidad por intent
         (apps con actividad LAUNCHER), no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Modo bloqueo total (pomodoro): BlockerAccessibilityService necesita resolver el
             paquete del launcher/home para eximirlo del bloqueo (categoría HOME, distinta de
             LAUNCHER arriba). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Modo bloqueo total: el manejador por defecto de ASSIST (el buscador/"at a glance" de
             Google incrustado en la pantalla de inicio) también se resuelve para eximirlo; ver
             comentario junto a resolvedAssist en BlockerAccessibilityService. -->
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
    </queries>

    <application
        android:name=".database.DBMigration"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BBetter.NoActionBar"
        tools:targetApi="33">

        <activity
            android:name=".configuration.SplashActivity"
            android:theme="@style/Theme.BBetter.NoActionBar"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar"/>
        <activity
            android:name=".calendarEntries.AddEventActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar"/>
        <activity
            android:name=".ui.progress.apppicker.AppPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BBetter.NoActionBar"/>

        <!-- F0-u5: shares the PNG share cards (cache/shared/ only, see res/xml/file_paths.xml).
             The authority is built from the applicationId, never from the namespace. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ui.home.HomeForegroundService"
            android:foregroundServiceType="specialUse" />

        <!-- Phase 4a: servicio de Accesibilidad que hace cumplir los límites diarios cubriendo la
             app. BIND_ACCESSIBILITY_SERVICE va en la etiqueta <service> (no es <uses-permission>);
             exported=false + el sistema es quien lo enlaza cuando el usuario lo activa en Ajustes. -->
        <service
            android:name=".blocking.BlockerAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/blocker_accessibility_config" />
        </service>

        <!-- F2-u6: App Link de invitación https://bbetter-dbcda.web.app/i/<código>. En el manifest principal desde L-u6 (L.7);
             inerte sin FEATURE_SOCIAL. El assetlinks.json de firebase/hosting lleva el SHA-256 de debug
             hasta que el usuario añada el de release. En el AVD la verificación no puede pasar: se aprueba a mano con
             adb shell pm set-app-links-user-selection (comando completo en firebase/README.md, «Invitaciones
             y Hosting»). Sin UI: guarda el código y relanza la app con el intent
             del launcher (nunca un VIEW sobre SplashActivity). taskAffinity vacío: no se mete en la tarea
             de la app, así el intent del launcher encuentra la tarea viva o crea una nueva. -->
        <activity
            android:name="com.example.bbettercalendar.ui.social.InviteLinkActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="bbetter-dbcda.web.app"
                    android:pathPrefix="/i/" />
            </intent-filter>
        </activity>

        <!-- F5-u6 (D-034): push de amigos (ánimo, empujón, solicitud) en el canal «Amigos». Sin
             FEATURE_SOCIAL el servicio no hace nada. exported=false: FCM entrega por un receptor propio. -->
        <service
            android:name=".social.push.FriendsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- F5-u6: FCM no registra el dispositivo solo. Solo PushTokenRegistrar pide el token, y solo con
             FEATURE_SOCIAL (release nunca lo hace) y fuera del Emulator Suite (D-034 d8). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <receiver
            android:name=".notifications.event.EventReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".usage.limits.UsageLimitReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.project.ProjectDeadlineReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.event.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Añadir el permiso de servicio en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
</manifest>