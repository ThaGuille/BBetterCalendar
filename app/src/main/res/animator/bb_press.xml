<?xml version="1.0" encoding="utf-8"?>
<!-- Default press of buttons, FAB, clickable cards and chips: scale to 0.93 in 80 ms, back with a soft bounce in 300 ms.
     StateListAnimator: the framework skips it when animations are off (final state stays at scale 1). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/bb_motion_press_down"
                android:interpolator="@interpolator/bb_standard"
                android:propertyName="scaleX"
                android:valueTo="0.93"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/bb_motion_press_down"
                android:interpolator="@interpolator/bb_standard"
                android:propertyName="scaleY"
                android:valueTo="0.93"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/bb_motion_press_up"
                android:interpolator="@interpolator/bb_overshoot"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/bb_motion_press_up"
                android:interpolator="@interpolator/bb_overshoot"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
