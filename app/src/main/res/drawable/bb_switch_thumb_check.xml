<?xml version="1.0" encoding="utf-8"?>
<!-- u19 · Focus shield switch thumb (html 14): on = 24dp pine dot with a sage check; off = the
     default Widget.BBetter.Switch small lichen dot. Same 24x28 box and no-<inset> rule as
     bb_switch_thumb (u7). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="@dimen/switch_thumb_size" android:height="@dimen/switch_track_height" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="@dimen/switch_thumb_size_off" android:height="@dimen/switch_thumb_size_off" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/bb_disabled" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="@dimen/switch_thumb_size" android:height="@dimen/switch_track_height" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="@dimen/switch_thumb_size" android:height="@dimen/switch_thumb_size" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/bb_on_primary" />
                </shape>
            </item>
            <item android:drawable="@drawable/bb_switch_check_glyph" android:gravity="center" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="@dimen/switch_thumb_size" android:height="@dimen/switch_track_height" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="@dimen/switch_thumb_size_off" android:height="@dimen/switch_thumb_size_off" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/bb_on_surface_muted" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
