<?xml version="1.0" encoding="utf-8"?>
<!-- Widget.BBetter.Switch track (u7): MD3-style pill as in .stitch/html/14 (48x28, sage when on).
     SwitchCompat sizes the switch as 2 x thumb width + this drawable's horizontal padding, so
     24dp thumbs + 2dp padding = 52x28. Off = raised surface with a hairline outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <size android:height="@dimen/switch_track_height" />
            <padding android:left="2dp" android:right="2dp" />
            <solid android:color="@color/bb_surface_raised" />
            <stroke android:width="2dp" android:color="@color/bb_outline" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <size android:height="@dimen/switch_track_height" />
            <padding android:left="2dp" android:right="2dp" />
            <solid android:color="@color/bb_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <size android:height="@dimen/switch_track_height" />
            <padding android:left="2dp" android:right="2dp" />
            <solid android:color="@color/bb_surface_raised" />
            <stroke android:width="2dp" android:color="@color/bb_outline" />
        </shape>
    </item>
</selector>
