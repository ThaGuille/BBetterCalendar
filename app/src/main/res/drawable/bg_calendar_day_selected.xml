<?xml version="1.0" encoding="utf-8"?>
<!-- Dia seleccionado (pomodoro-calendario-ui u5): contorno claro, sin relleno, para que el tinte de
     enfoque (bg_calendar_focus_N, debajo) siga viendose. Mismo inset y radio que el tinte. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="@dimen/calendar_cell_inset">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/radius_md" />
        <stroke
            android:width="@dimen/calendar_selected_stroke"
            android:color="@color/bb_cal_selected_outline" />
        <solid android:color="@android:color/transparent" />
    </shape>
</inset>
