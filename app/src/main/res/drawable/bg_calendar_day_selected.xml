<?xml version="1.0" encoding="utf-8"?>
<!-- Dia seleccionado: relleno salvia (mejora-visual u12). El anillo cuadrado queda reservado para
     "hoy" (bg_calendar_day_today), asi ambos se distinguen y pueden coincidir en la misma celda.
     Mismo inset que el recuadro de hoy para que se alineen. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="@dimen/calendar_cell_inset">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/radius_sm" />
        <solid android:color="@color/bb_primary" />
    </shape>
</inset>
