<?xml version="1.0" encoding="utf-8"?>
<!-- Dia seleccionado en la tira semanal: columna elevada con contorno fino.
     Sin <inset> ni <padding> a proposito: un fondo con padding propio sustituye el padding de la vista al
     ponerlo en tiempo de ejecucion, y la columna seleccionada perdia su margen superior (letra y numero
     subian y la tira cambiaba de alto). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/radius_md" />
    <solid android:color="@color/bb_surface_card" />
    <stroke
        android:width="@dimen/calendar_selected_stroke"
        android:color="@color/bb_outline" />
</shape>
