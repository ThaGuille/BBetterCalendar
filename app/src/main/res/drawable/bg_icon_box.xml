<?xml version="1.0" encoding="utf-8"?>
<!-- Icon box (mejora-visual u2): 36dp, 11dp radius, bb_primary_container, light rim on top. Style Widget.BBetter.IconBox. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="@dimen/icon_box_size" android:height="@dimen/icon_box_size" />
            <solid android:color="@color/bb_card_lit_edge" />
            <corners android:radius="@dimen/icon_box_radius" />
        </shape>
    </item>
    <item android:top="@dimen/card_lit_rim">
        <shape android:shape="rectangle">
            <solid android:color="@color/bb_primary_container" />
            <corners android:radius="@dimen/icon_box_radius" />
        </shape>
    </item>
</layer-list>
