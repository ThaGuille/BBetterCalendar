<?xml version="1.0" encoding="utf-8"?>
<!-- rediseno-proyectos: ring that marks the chosen colour dot (the dot itself is drawn in code). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <stroke
                android:width="@dimen/projects_form_ring_stroke"
                android:color="@color/bb_on_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="1dp" android:height="1dp" />
        </shape>
    </item>
</selector>
