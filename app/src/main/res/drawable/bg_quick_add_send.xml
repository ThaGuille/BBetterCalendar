<?xml version="1.0" encoding="utf-8"?>
<!-- Send button of the quick-add box: sage when enabled, a quiet surface while the title is blank. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/bb_surface_highest" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bb_primary" />
        </shape>
    </item>
</selector>
