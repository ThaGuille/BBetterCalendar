<?xml version="1.0" encoding="utf-8"?>
<!-- Focus top-bar action without a visible container (block mode): only the round press ripple,
     inset like the 40dp circles so the touch target stays 48dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bb_ripple_primary">
    <item android:id="@android:id/mask">
        <inset
            android:insetBottom="@dimen/focus_action_inset"
            android:insetLeft="@dimen/focus_action_inset"
            android:insetRight="@dimen/focus_action_inset"
            android:insetTop="@dimen/focus_action_inset">
            <shape android:shape="oval">
                <solid android:color="@color/bb_ripple_primary" />
            </shape>
        </inset>
    </item>
</ripple>
