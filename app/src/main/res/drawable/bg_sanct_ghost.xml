<?xml version="1.0" encoding="utf-8"?>
<!-- Focus stop / skip (html 01b): 48dp ghost circle, rgba(19,34,28,.6) + 1px sage rim at 30 %. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bb_ripple_primary">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bb_sanct_ghost_fill" />
            <stroke android:width="1dp" android:color="@color/bb_sanct_ghost_rim" />
        </shape>
    </item>
</ripple>
