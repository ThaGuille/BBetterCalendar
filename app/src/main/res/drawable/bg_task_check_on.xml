<?xml version="1.0" encoding="utf-8"?>
<!-- u13: checked task circle (html 04: secondary-container disc + sage check). The check is
     inset so it works on API 21 (layer-list item width/height/gravity are API 23+). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="@dimen/home_task_check_size" android:height="@dimen/home_task_check_size" />
            <solid android:color="@color/bb_primary_container" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:drawable="@drawable/ic_task_check_mark"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp" />
</layer-list>
