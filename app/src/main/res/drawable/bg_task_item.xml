<?xml version="1.0" encoding="utf-8"?>
<!-- Marco de cada fila de tarea en Home (item_today_task): separa visualmente una tarea de otra
     dentro de la card blanca. Estructural; el estilo definitivo llegará con el overhaul. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bb_surface_card" />
    <stroke
        android:width="1dp"
        android:color="@color/bb_divider" />
    <corners android:radius="@dimen/radius_md" />
</shape>
