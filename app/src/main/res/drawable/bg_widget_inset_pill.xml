<?xml version="1.0" encoding="utf-8"?>
<!-- u9: inset pill (StatTileView delta chip). Background-coloured, so primary AND danger text both
     pass AA on it (u4 table: sage 7.25:1, ember 5.91:1); a raised pill would fail for ember. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bb_surface" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
