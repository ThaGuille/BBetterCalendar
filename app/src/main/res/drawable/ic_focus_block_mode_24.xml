<?xml version="1.0" encoding="utf-8"?>
<!-- Focus block mode: a phone silhouette with a padlock on its screen = "this phone is locked to
     your focus (apps blocked)". Not the generic prohibited sign. The tint states off / on / needs
     permission come from FocusFragment.renderBlockMode. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- Phone body: rounded outline (outer minus inner screen). -->
    <path
        android:fillColor="@color/bb_on_surface"
        android:fillType="evenOdd"
        android:pathData="M8,1.5h8a2.5,2.5 0 0 1 2.5,2.5v16a2.5,2.5 0 0 1 -2.5,2.5H8A2.5,2.5 0 0 1 5.5,20V4A2.5,2.5 0 0 1 8,1.5zM8,3.5a0.5,0.5 0 0 0 -0.5,0.5v16a0.5,0.5 0 0 0 0.5,0.5h8a0.5,0.5 0 0 0 0.5,-0.5V4a0.5,0.5 0 0 0 -0.5,-0.5H8z" />
    <!-- Padlock body. -->
    <path
        android:fillColor="@color/bb_on_surface"
        android:pathData="M9.5,12h5a0.75,0.75 0 0 1 0.75,0.75v3.5a0.75,0.75 0 0 1 -0.75,0.75h-5a0.75,0.75 0 0 1 -0.75,-0.75v-3.5A0.75,0.75 0 0 1 9.5,12z" />
    <!-- Padlock shackle. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M10.25,12V10.5a1.75,1.75 0 0 1 3.5,0V12"
        android:strokeColor="@color/bb_on_surface"
        android:strokeLineCap="round"
        android:strokeWidth="1.4" />
</vector>
