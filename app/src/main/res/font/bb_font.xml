<?xml version="1.0" encoding="utf-8"?>
<!-- La familia por defecto de la app (plan migracion-visual-stitch, u6): Plus Jakarta Sans
     empaquetada (OFL, licencia en .stitch/assets/fonts/OFL.txt). Tema y TextAppearance.BBetter.*
     de 400/700 apuntan aquí; 700 = textStyle="bold" (elige la cara 700 real, todas las API).
     u9b: los pesos 500/600 viven en familias propias (bb_font_medium.xml / bb_font_semibold.xml),
     porque AppCompat ignora android:textFontWeight dentro de un TextAppearance. Para cambiar la
     fuente se cambian los ficheros de res/font/bb_font*.xml (y nada más).
     android: = API 26+ framework, app: = AndroidX/AppCompat (API 21-25). Las caras 500/600/800 de
     esta familia sólo las usa Java (FontHelper.appTypeface(ctx, weight), API 28+). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/plus_jakarta_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/plus_jakarta_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/plus_jakarta_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/plus_jakarta_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/plus_jakarta_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/plus_jakarta_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/plus_jakarta_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/plus_jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/plus_jakarta_sans_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/plus_jakarta_sans_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
