<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/calendar_cell_height">

    <!-- Canales separados (pomodoro-calendario-ui u5), los elige MonthDayBinder con DayCellStyle:
         fondo = tinte ambar por minutos de enfoque (bg_calendar_focus_N); seleccion = contorno claro
         encima (cellSelectedOutline) que deja ver el tinte; hoy = circulo relleno detras del numero
         (cellTodayIndicator); puntos = tipos de elemento. -->
    <View
        android:id="@+id/cellFocusBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/cellSelectedOutline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_day_selected"
        android:visibility="gone" />

    <!-- Marca de hoy: circulo relleno detras del numero. -->
    <View
        android:id="@+id/cellTodayIndicator"
        android:layout_width="@dimen/calendar_today_circle_size"
        android:layout_height="@dimen/calendar_today_circle_size"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="@dimen/calendar_today_circle_top"
        android:background="@drawable/bg_calendar_day_today"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cellDayText"
        android:layout_width="@dimen/calendar_today_circle_size"
        android:layout_height="@dimen/calendar_today_circle_size"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="@dimen/calendar_today_circle_top"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Label"
        android:textColor="@color/bb_on_surface" />

    <!-- Hasta 3 puntos por tipo (tarea / evento / entrega / recordatorio). -->
    <LinearLayout
        android:id="@+id/cellDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="@dimen/calendar_cell_dots_bottom"
        android:orientation="horizontal">

        <View
            android:id="@+id/cellDot1"
            style="@style/Widget.BBetter.CalendarDot"
            android:visibility="gone" />

        <View
            android:id="@+id/cellDot2"
            style="@style/Widget.BBetter.CalendarDot"
            android:visibility="gone" />

        <View
            android:id="@+id/cellDot3"
            style="@style/Widget.BBetter.CalendarDot"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
