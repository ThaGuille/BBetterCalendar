<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/calendar_cell_height">

    <!-- Fondo de la celda: tinte por minutos de enfoque (bg_calendar_focus_N) o, si está
         seleccionada, relleno salvia (bg_calendar_day_selected). Lo elige MonthDayBinder. -->
    <View
        android:id="@+id/cellFocusBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Marca de hoy: anillo que ocupa la celda entera. -->
    <View
        android:id="@+id/cellTodayIndicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_day_today"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cellDayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:paddingTop="@dimen/calendar_cell_text_top"
        android:textAppearance="@style/TextAppearance.BBetter.Label"
        android:textColor="@color/bb_on_surface" />

    <!-- Hasta 3 puntos por tipo (tarea / evento / entrega / recordatorio). -->
    <LinearLayout
        android:id="@+id/cellDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="@dimen/calendar_cell_dots_bottom"
        android:orientation="horizontal">

        <View
            android:id="@+id/cellDot1"
            style="@style/Widget.BBetter.CalendarDot"
            android:visibility="gone" />

        <View
            android:id="@+id/cellDot2"
            style="@style/Widget.BBetter.CalendarDot"
            android:visibility="gone" />

        <View
            android:id="@+id/cellDot3"
            style="@style/Widget.BBetter.CalendarDot"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
