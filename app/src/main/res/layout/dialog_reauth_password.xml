<?xml version="1.0" encoding="utf-8"?>
<!-- F1-u7 · Password field of the re-authentication step of Delete account. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_lg">

    <EditText
        android:id="@+id/reauthPasswordInput"
        style="@style/Widget.BBetter.Social.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/delete_reauth_password_hint"
        android:imeOptions="actionDone"
        android:inputType="textPassword" />
</FrameLayout>
