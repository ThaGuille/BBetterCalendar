<?xml version="1.0" encoding="utf-8"?>
<!-- «Todo tu progreso» (mejora-visual u8): barra superior + selector de periodo fijo (Dia/Semana/Mes/Año +
     navegador) + NestedScrollView con 8 tarjetas (item_chart_card). Mockups 11-18.
     Las 8 tarjetas son include con id propio: la raiz de item_chart_card no lleva id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/allProgressScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.progress.AllProgressFragment">

    <include layout="@layout/view_top_bar" />

    <com.example.bbettercalendar.ui.common.widget.SegmentedControlView
        android:id="@+id/allProgressGranularity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md" />

    <com.example.bbettercalendar.ui.common.widget.PeriodNavigatorView
        android:id="@+id/allProgressPeriodNavigator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_card_gap"
        android:layout_marginEnd="@dimen/spacing_md" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/allProgressScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/progress_bottom_clearance">

            <include
                android:id="@+id/allProgressCardFocusByDay"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCardBestHours"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCard12Weeks"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCardConsistency"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCardSessions"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCardProjects"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCardDurations"
                layout="@layout/item_chart_card" />

            <include
                android:id="@+id/allProgressCardFocusVsPhone"
                layout="@layout/item_chart_card" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
