<?xml version="1.0" encoding="utf-8"?>
<!-- u20 · Per-app detail (.stitch/designs/10-app-detail-instagram.png + html/10).
     Cabecera fija (flecha + icono + nombre + categoria) y debajo un scroll: Week/Month, 3 tiles,
     "Past 7 days" (BarChart en codigo, ChartStyler), "Daily limit" (StepperView + presets),
     filas Warn / Block, nota y "Stop tracking". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appDetailScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.screentime.AppDetailFragment">

    <!-- ============ Cabecera ============ -->
    <LinearLayout
        android:id="@+id/appDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_md">

        <ImageButton
            android:id="@+id/appDetailBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/bb_on_surface" />

        <ImageView
            android:id="@+id/appDetailIcon"
            android:layout_width="@dimen/app_detail_header_icon"
            android:layout_height="@dimen/app_detail_header_icon"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/bg_app_detail_icon"
            android:importantForAccessibility="no"
            android:padding="@dimen/app_detail_header_icon_padding"
            tools:src="@drawable/ic_shield_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BBetter.Headline"
                tools:text="Instagram" />

            <TextView
                android:id="@+id/appDetailSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BBetter.Micro"
                tools:text="Social media • Limited" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/appDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md">

            <!-- ============ Week / Month ============ -->
            <com.example.bbettercalendar.ui.common.widget.SegmentedControlView
                android:id="@+id/appDetailPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:segmentEntries="@array/app_detail_periods"
                app:segmentSelected="0" />

            <!-- ============ 3 tiles ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.example.bbettercalendar.ui.common.widget.StatTileView
                    android:id="@+id/appDetailTileToday"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:tileLabel="@string/app_detail_tile_today" />

                <com.example.bbettercalendar.ui.common.widget.StatTileView
                    android:id="@+id/appDetailTileAvg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/app_detail_tile_gap"
                    android:layout_weight="1"
                    app:tileLabel="@string/app_detail_tile_avg" />

                <!-- PLACEHOLDER(ui-placeholders#app-detail-blocked-opens): no se cuentan aperturas bloqueadas. -->
                <LinearLayout
                    android:id="@+id/appDetailTileBlocked"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/app_detail_tile_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/widget_tile_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/app_detail_tile_blocked"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                        <ImageView
                            android:layout_width="@dimen/widget_tile_icon_size"
                            android:layout_height="@dimen/widget_tile_icon_size"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield_24"
                            app:tint="@color/bb_accent_reward" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/appDetailBlockedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.BBetter.Stat.Tile"
                        tools:text="6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/app_detail_tile_blocked_sub"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Past 7 days ============ -->
            <LinearLayout
                android:id="@+id/appDetailChartCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/appDetailChartTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_chart_title_week"
                            android:textAppearance="@style/TextAppearance.BBetter.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_chart_subtitle"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/app_detail_legend_swatch"
                            android:layout_height="@dimen/app_detail_legend_swatch"
                            android:background="@drawable/bg_app_detail_swatch_within" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/app_detail_legend_within"
                            android:textAppearance="@style/TextAppearance.BBetter.Micro" />

                        <View
                            android:layout_width="@dimen/app_detail_legend_swatch"
                            android:layout_height="@dimen/app_detail_legend_swatch"
                            android:layout_marginStart="@dimen/spacing_card_gap"
                            android:background="@drawable/bg_app_detail_swatch_over" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/app_detail_legend_over"
                            android:textAppearance="@style/TextAppearance.BBetter.Micro" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/appDetailChartHolder"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_detail_chart_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:contentDescription="@string/app_detail_chart_cd" />
            </LinearLayout>

            <!-- ============ Daily limit ============ -->
            <LinearLayout
                android:id="@+id/appDetailLimitCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_limit_title"
                            android:textAppearance="@style/TextAppearance.BBetter.Title" />

                        <TextView
                            android:id="@+id/appDetailLimitSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption"
                            tools:text="Time granted before Instagram is paused" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/appDetailLimitBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_app_detail_badge"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingBottom="2dp"
                        android:text="@string/app_detail_limit_active"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        android:textColor="@color/bb_primary" />
                </LinearLayout>

                <com.example.bbettercalendar.ui.common.widget.StepperView
                    android:id="@+id/appDetailStepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:stepperMax="240"
                    app:stepperMin="0"
                    app:stepperStep="5"
                    app:stepperUnit="@string/app_detail_stepper_unit"
                    app:stepperCaption="@string/app_detail_stepper_caption" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/appDetailPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/spacing_sm"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/appDetailPreset30"
                            style="@style/Widget.BBetter.Chip.Preset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_preset_30" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/appDetailPreset45"
                            style="@style/Widget.BBetter.Chip.Preset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_preset_45" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/appDetailPreset60"
                            style="@style/Widget.BBetter.Chip.Preset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_preset_60" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/appDetailPresetNone"
                            style="@style/Widget.BBetter.Chip.Preset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_preset_none" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ============ Warn / Block ============ -->
            <LinearLayout
                android:id="@+id/appDetailProtectCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/appDetailWarnRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="@dimen/app_detail_row_icon_tile"
                        android:layout_height="@dimen/app_detail_row_icon_tile"
                        android:background="@drawable/bg_app_detail_row_icon"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/app_detail_row_icon_padding"
                        android:src="@drawable/ic_notifications_empty_24"
                        app:tint="@color/bb_on_surface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_warn_title"
                            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_detail_warn_sub"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/appDetailWarnValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        android:textColor="@color/bb_secondary"
                        tools:text="5 min before" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/bb_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_hairline"
                    android:background="@color/bb_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/app_detail_row_icon_tile"
                            android:layout_height="@dimen/app_detail_row_icon_tile"
                            android:background="@drawable/bg_app_detail_row_icon"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/app_detail_row_icon_padding"
                            android:src="@drawable/ic_block_24"
                            app:tint="@color/bb_on_surface" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_card_gap"
                            android:layout_weight="1"
                            android:text="@string/app_detail_block_title"
                            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/appDetailBlockSwitch"
                            style="@style/Widget.BBetter.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:contentDescription="@string/app_detail_block_title"
                            android:thumb="@drawable/bb_switch_thumb_check" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="44dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/app_detail_block_desc"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                    <LinearLayout
                        android:id="@+id/appDetailA11yStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="44dp"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/appDetailA11yDot"
                            android:layout_width="@dimen/app_detail_status_dot"
                            android:layout_height="@dimen/app_detail_status_dot"
                            android:background="@drawable/bg_dot_primary" />

                        <TextView
                            android:id="@+id/appDetailA11yText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                            android:textColor="@color/bb_primary"
                            tools:text="Enabled" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Nota ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info_24"
                    app:tint="@color/bb_on_surface_muted" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="@string/app_detail_note"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />
            </LinearLayout>

            <!-- ============ Stop tracking ============ -->
            <TextView
                android:id="@+id/appDetailStopTracking"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_detail_stop_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                android:textColor="@color/bb_danger"
                tools:text="Stop tracking Instagram" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
