<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarMonthRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    tools:context=".ui.calendar.CalendarFragmentMonth">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_calendar_mode_toggle" />

        <!-- La pagina entera desplaza: con la rejilla (hasta 6 filas) la agenda no cabe debajo. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/calendarMonthScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- B7: la rejilla del mes vive dentro de una tarjeta. -->
        <LinearLayout
            android:id="@+id/monthGridCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/bg_calendar_grid_card"
            android:orientation="vertical">

        <!-- Header bar: prev arrow | month-year | next arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/monthPrevButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/month_view_prev"
                android:src="@drawable/ic_chevron_left_24"
                app:tint="@color/bb_on_surface" />

            <TextView
                android:id="@+id/monthTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.BBetter.Title"
                tools:text="June 2026" />

            <ImageButton
                android:id="@+id/monthNextButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/month_view_next"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/bb_on_surface" />
        </LinearLayout>

        <include layout="@layout/view_calendar_header" />

        <com.kizitonwose.calendar.view.CalendarView
            android:id="@+id/monthCalendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cv_dayViewResource="@layout/cell_month_day"
            app:cv_daySize="seventhWidth"
            app:cv_orientation="horizontal"
            app:cv_outDateStyle="endOfGrid"
            app:cv_scrollPaged="true" />

        <!-- Leyenda: tipos (puntos) y enfoque (cuadrado teñido). -->
        <LinearLayout
            android:id="@+id/calendarLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <View
                style="@style/Widget.BBetter.CalendarDot"
                android:backgroundTint="@color/calendar_item_task" />
            <TextView
                style="@style/CalendarLegendLabel"
                android:text="@string/calendar_legend_task" />

            <View
                style="@style/Widget.BBetter.CalendarDot"
                android:backgroundTint="@color/calendar_item_event" />
            <TextView
                style="@style/CalendarLegendLabel"
                android:text="@string/calendar_legend_event" />

            <View
                style="@style/Widget.BBetter.CalendarDot"
                android:backgroundTint="@color/calendar_item_deadline" />
            <TextView
                style="@style/CalendarLegendLabel"
                android:text="@string/calendar_legend_deadline" />

            <View
                style="@style/Widget.BBetter.CalendarDot"
                android:backgroundTint="@color/bb_cal_focus_3" />
            <TextView
                style="@style/CalendarLegendLabel"
                android:text="@string/calendar_legend_focus" />
        </LinearLayout>

        </LinearLayout>

        <!-- Agenda del dia (mejora-visual u12): tarjeta con titulo, resumen, "+" y filas. -->
        <LinearLayout
            android:id="@+id/calendarAgendaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@drawable/bg_calendar_grid_card"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dayDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.Title"
                        tools:text="Jueves 12" />

                    <TextView
                        android:id="@+id/dayDetailSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                        tools:text="3 cosas · 1 h 30 m previstos" />
                </LinearLayout>

                <!-- "+" crea en el dia seleccionado (antes: FAB). -->
                <ImageButton
                    android:id="@+id/calendarAddEventButton"
                    android:layout_width="@dimen/calendar_agenda_add_size"
                    android:layout_height="@dimen/calendar_agenda_add_size"
                    android:background="@drawable/bg_calendar_agenda_add"
                    android:contentDescription="@string/calendar_add_entry"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/bb_on_primary" />
            </LinearLayout>

            <com.example.bbettercalendar.ui.common.widget.EmptyStateView
                android:id="@+id/dayDetailEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dayDetailRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm" />
        </LinearLayout>

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
