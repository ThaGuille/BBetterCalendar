<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarMonthRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    tools:context=".ui.calendar.CalendarFragmentMonth">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_calendar_mode_toggle" />

        <!-- B7: la rejilla del mes vive dentro de una tarjeta. -->
        <LinearLayout
            android:id="@+id/monthGridCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/bg_calendar_grid_card"
            android:orientation="vertical">

        <!-- Header bar: prev arrow | month-year | next arrow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/monthPrevButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/month_view_prev"
                android:src="@drawable/ic_chevron_left_24"
                app:tint="@color/bb_on_surface" />

            <TextView
                android:id="@+id/monthTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.BBetter.Title"
                tools:text="June 2026" />

            <ImageButton
                android:id="@+id/monthNextButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/month_view_next"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/bb_on_surface" />
        </LinearLayout>

        <include layout="@layout/view_calendar_header" />

        <com.kizitonwose.calendar.view.CalendarView
            android:id="@+id/monthCalendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cv_dayViewResource="@layout/cell_month_day"
            app:cv_daySize="square"
            app:cv_orientation="horizontal"
            app:cv_outDateStyle="endOfGrid"
            app:cv_scrollPaged="true" />

        </LinearLayout>

        <!-- Day-detail panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Sin botón "Add for this day": el FAB ya crea en el día seleccionado
                     (spec frontend-structure-cleanup). -->
                <TextView
                    android:id="@+id/dayDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                    tools:text="Events for Jun 15, 2026" />
            </LinearLayout>

            <TextView
                android:id="@+id/dayDetailEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="12dp"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dayDetailRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/calendar_fab_clearance" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/calendarAddEventButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/calendar_add_entry"
        app:srcCompat="@drawable/ic_add_24" />

</FrameLayout>
