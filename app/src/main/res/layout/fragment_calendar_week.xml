<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarWeekRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    tools:context=".ui.calendar.CalendarFragmentWeek">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_calendar_mode_toggle" />

        <TextView
            android:id="@+id/weekMonthTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bb_surface"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.BBetter.Title"
            tools:text="mayo 2026" />

        <com.example.bbettercalendar.ui.calendar.weekview.WeekView
            android:id="@+id/weekView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:adaptiveEventTextSize="true"
            app:columnGap="0dp"
            app:dayBackgroundColor="@color/bb_surface"
            app:daySeparatorColor="@color/bb_divider"
            app:defaultEventColor="@color/bb_secondary"
            app:eventPaddingHorizontal="2dp"
            app:eventTextColor="@color/bb_on_primary"
            app:eventTextSize="10sp"
            app:futureBackgroundColor="@color/bb_surface"
            app:futureWeekendBackgroundColor="@color/bb_surface"
            app:headerBackgroundColor="@color/bb_surface_card"
            app:headerBottomLineColor="@color/bb_divider"
            app:headerBottomShadowColor="@color/bb_scrim"
            app:headerTextColor="@color/bb_on_surface"
            app:hourHeight="72dp"
            app:hourSeparatorColor="@color/bb_divider"
            app:maxHourHeight="120dp"
            app:minHourHeight="48dp"
            app:nowLineColor="@color/bb_accent_reward"
            app:nowLineDotColor="@color/bb_accent_reward"
            app:numberOfVisibleDays="7"
            app:pastBackgroundColor="@color/bb_surface"
            app:pastWeekendBackgroundColor="@color/bb_surface"
            app:showCurrentTimeFirst="true"
            app:showFirstDayOfWeekFirst="true"
            app:showHeaderBottomLine="true"
            app:timeColumnBackgroundColor="@color/bb_surface"
            app:timeColumnSeparatorColor="@color/bb_divider"
            app:timeColumnTextColor="@color/bb_on_surface_muted"
            app:todayBackgroundColor="@color/bb_surface_card"
            app:todayHeaderTextColor="@color/bb_primary"
            app:weekNumberBackgroundColor="@color/bb_surface_subtle"
            app:weekNumberTextColor="@color/bb_on_surface"
            app:weekendHeaderTextColor="@color/bb_on_surface_muted" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/calendarAddEventButton2"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/calendar_add_entry"
        app:srcCompat="@drawable/ic_add_24" />

</FrameLayout>
