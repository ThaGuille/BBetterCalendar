<?xml version="1.0" encoding="utf-8"?>
<!-- F1-u5 · Create profile: name, @username (live validation + availability), avatar colour, terms. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createProfileScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.social.CreateProfileFragment">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:id="@+id/cpScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <com.example.bbettercalendar.ui.common.widget.AvatarView
                android:id="@+id/cpAvatarPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:avatarSize="@dimen/social_avatar_preview" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/create_profile_title"
                android:textAppearance="@style/TextAppearance.BBetter.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/create_profile_body"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

            <EditText
                android:id="@+id/cpNameInput"
                style="@style/Widget.BBetter.Social.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:hint="@string/create_profile_name_hint"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="30" />

            <EditText
                android:id="@+id/cpHandleInput"
                style="@style/Widget.BBetter.Social.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/create_profile_handle_hint"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLength="21" />

            <TextView
                android:id="@+id/cpHandleStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/create_profile_handle_help"
                android:textAppearance="@style/TextAppearance.BBetter.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/create_profile_color_label"
                android:textAppearance="@style/TextAppearance.BBetter.Label" />

            <com.example.bbettercalendar.ui.social.AvatarColorPickerView
                android:id="@+id/cpColorPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cpTermsCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp" />

                <TextView
                    android:id="@+id/cpTermsText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BBetter.Body" />
            </LinearLayout>

            <TextView
                android:id="@+id/cpError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.BBetter.SocialError"
                android:visibility="gone"
                tools:text="That username is not available. Choose another one." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cpSaveButton"
                style="@style/Widget.BBetter.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:enabled="false"
                android:text="@string/create_profile_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
