<?xml version="1.0" encoding="utf-8"?>
<!-- u12: destination shell (top bar + back). Real content arrives in its screen unit (u14–u20). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cycleCompleteScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.focus.CycleCompleteFragment">

    <include layout="@layout/view_top_bar" />

    <com.example.bbettercalendar.ui.common.widget.EmptyStateView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        app:emptyTitle="@string/title_cycle_complete"
        app:emptyMessage="@string/screen_placeholder_message" />

</LinearLayout>
