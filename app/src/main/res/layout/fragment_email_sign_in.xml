<?xml version="1.0" encoding="utf-8"?>
<!-- F1-u4 · Email sign-up / sign-in / forgotten password (D-023). One form, two modes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emailScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.social.EmailSignInFragment">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/emailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.BBetter.Headline"
                tools:text="Create your account" />

            <EditText
                android:id="@+id/emailInput"
                style="@style/Widget.BBetter.Social.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:autofillHints="emailAddress"
                android:hint="@string/email_hint_email"
                android:importantForAutofill="yes"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/passwordInput"
                style="@style/Widget.BBetter.Social.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:autofillHints="password"
                android:hint="@string/email_hint_password"
                android:importantForAutofill="yes"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/emailMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.BBetter.SocialError"
                android:visibility="gone"
                tools:text="That email does not look right." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emailSubmitButton"
                style="@style/Widget.BBetter.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                tools:text="Create account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emailSwitchButton"
                style="@style/Widget.BBetter.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                tools:text="I already have an account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emailForgotButton"
                style="@style/Widget.BBetter.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email_forgot" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
