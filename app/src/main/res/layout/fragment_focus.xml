<?xml version="1.0" encoding="utf-8"?>
<!-- Focus (migración visual u14, .stitch/designs/01-focus-running.png + .stitch/html/01-focus-running.html).
     Top bar centrada (back + 🚫 modo bloqueo en el menú) · chip de modo + puntos de ciclo · anillo
     con el restante y "Ends at" · stop / pausa-play / saltar descanso · tira Today/Streak (+ fallos
     de hoy) · "Studying now" (maqueta social) · "Invite friends" (inerte). La sesión vive en
     FocusSessionViewModel (ámbito de actividad); back vuelve a Home SIN cancelar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/focusScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.focus.FocusFragment">

    <include layout="@layout/view_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/focusScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- ============ Chip de modo + puntos de ciclo ============ -->
            <TextView
                android:id="@+id/focusModeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_meta_pill"
                android:paddingStart="14dp"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="14dp"
                android:paddingBottom="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.BBetter.Chip"
                android:textColor="@color/bb_on_surface_muted"
                tools:text="Concentration · 2 of 4" />

            <LinearLayout
                android:id="@+id/focusCycleDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <!-- ============ Anillo + restante + "Ends at" ============ -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/focusRing"
                    style="@style/Widget.BBetter.CircularProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    app:indicatorSize="@dimen/focus_ring_size"
                    tools:progress="600" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/focusTimerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextAppearance.BBetter.Display"
                        android:textSize="@dimen/focus_timer_text"
                        tools:text="18:42" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_card_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/focusEndsAtIcon"
                            android:layout_width="@dimen/home_inline_stat_icon_size"
                            android:layout_height="@dimen/home_inline_stat_icon_size"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_clock_v2_24"
                            app:tint="@color/bb_on_surface_muted" />

                        <TextView
                            android:id="@+id/focusEndsAtText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Label"
                            tools:text="Ends at 17:30" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ============ Controles: stop · pausa/play · saltar descanso ============ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/focusStopButton"
                    android:layout_width="@dimen/focus_control_size"
                    android:layout_height="@dimen/focus_control_size"
                    android:background="@drawable/bg_focus_control"
                    android:contentDescription="@string/focus_stop"
                    android:padding="@dimen/spacing_md"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_stop_24"
                    app:tint="@color/bb_on_surface_muted" />

                <ImageButton
                    android:id="@+id/focusPlayButton"
                    android:layout_width="@dimen/play_button_size"
                    android:layout_height="@dimen/play_button_size"
                    android:layout_marginStart="@dimen/focus_control_gap"
                    android:layout_marginEnd="@dimen/focus_control_gap"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="@string/focus_pause"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause_v2_filled_24"
                    app:tint="@color/bb_on_primary" />

                <ImageButton
                    android:id="@+id/focusSkipButton"
                    android:layout_width="@dimen/focus_control_size"
                    android:layout_height="@dimen/focus_control_size"
                    android:background="@drawable/bg_focus_control"
                    android:contentDescription="@string/focus_skip_rest"
                    android:padding="@dimen/spacing_md"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next_24"
                    app:tint="@color/bb_on_surface_muted" />
            </LinearLayout>

            <!-- ============ Today / Streak ============ -->
            <LinearLayout
                android:id="@+id/focusStatsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_today"
                        android:textAppearance="@style/TextAppearance.BBetter.Label" />

                    <TextView
                        android:id="@+id/focusTodayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.BBetter.Stat.Tile"
                        tools:text="2h 14m" />

                    <TextView
                        android:id="@+id/focusFailsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        tools:text="1 missed session" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/widget_hairline"
                    android:layout_height="match_parent"
                    android:background="@color/bb_divider" />

                <LinearLayout
                    android:id="@+id/focusStreakColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_streak"
                        android:textAppearance="@style/TextAppearance.BBetter.Label" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/focusStreakText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Stat.Tile"
                            tools:text="12 days" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flame_v2_24"
                            app:tint="@color/bb_accent_reward" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Studying now (maqueta social) ============ -->
            <!-- PLACEHOLDER(ui-placeholders#social-focus-studying) -->
            <LinearLayout
                android:id="@+id/focusSocialBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical">

                <com.example.bbettercalendar.ui.common.widget.SectionHeaderView
                    android:id="@+id/focusStudyingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs"
                    app:headerMetaPill="true"
                    app:headerTitle="@string/focus_studying_now"
                    app:headerTitleAppearance="@style/TextAppearance.BBetter.BodyStrong" />

                <LinearLayout
                    android:id="@+id/focusFriendsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:orientation="vertical" />

                <!-- PLACEHOLDER(ui-placeholders#social-focus-invite): inerte (toast). -->
                <TextView
                    android:id="@+id/focusInviteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/button_text_height"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:text="@string/focus_invite_friends"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    app:drawableStartCompat="@drawable/ic_group_add_24"
                    app:drawableTint="@color/bb_on_surface_muted" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
