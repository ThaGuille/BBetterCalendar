<?xml version="1.0" encoding="utf-8"?>
<!-- Focus, «Calm Focus Sanctuary» (.stitch/designs/01b running · 01c rest · 01d paused; plan
     paleta-stitch-y-focus-sanctuary.md). Replaces the u14 layout of html 01.
     Top bar centrada (back + 🚫 modo bloqueo) · chip de estado con punto + puntos de ciclo · anillo
     con resplandor (FocusRingView) y "Ends at" · stop / pausa-play / saltar descanso · pista del
     descanso · tarjeta Today/Streak · "Studying now" (maqueta social) · "Invite friends".
     Los huecos con peso reparten el alto (html: main justify-evenly) para que todo quepa sin scroll;
     el NestedScrollView solo entra en juego en pantallas bajas o con letra grande.
     Only the bb_sanct_* tokens are used here. The session lives in FocusSessionViewModel (activity
     scope): back returns to Home WITHOUT cancelling. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/focusScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_sanct_surface"
    android:orientation="vertical"
    tools:context=".ui.focus.FocusFragment">

    <include layout="@layout/view_top_bar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_hairline"
        android:background="@color/bb_sanct_divider" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/focusScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <!-- ============ Chip de estado + puntos de ciclo ============ -->
            <LinearLayout
                android:id="@+id/focusModeChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sanct_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/focus_chip_padding_h"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/focus_chip_padding_h"
                android:paddingBottom="@dimen/spacing_xs">

                <View
                    android:id="@+id/focusModeDot"
                    android:layout_width="@dimen/focus_sanct_chip_dot"
                    android:layout_height="@dimen/focus_sanct_chip_dot"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_sanct_dot" />

                <TextView
                    android:id="@+id/focusModeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Chip"
                    android:textColor="@color/bb_sanct_sage_bright"
                    android:textSize="@dimen/focus_chip_text"
                    tools:text="Concentration · 2 of 4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/focusCycleDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/spacing_xs" />

            <!-- ============ Anillo con resplandor + restante + "Ends at" ============ -->
            <FrameLayout
                android:layout_width="@dimen/focus_sanct_ring_box"
                android:layout_height="@dimen/focus_sanct_ring_box">

                <com.example.bbettercalendar.ui.focus.FocusRingView
                    android:id="@+id/focusRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/focusTimerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextAppearance.BBetter.Display"
                        android:textColor="@color/bb_sanct_on_surface"
                        android:textSize="@dimen/focus_sanct_timer_text"
                        tools:text="18:42" />

                    <LinearLayout
                        android:id="@+id/focusEndsAtRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/focusEndsAtIcon"
                            android:layout_width="@dimen/home_inline_stat_icon_size"
                            android:layout_height="@dimen/home_inline_stat_icon_size"
                            android:layout_marginEnd="@dimen/focus_ends_at_icon_gap"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_clock_v2_24"
                            app:tint="@color/bb_sanct_sage_bright" />

                        <TextView
                            android:id="@+id/focusEndsAtText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Label"
                            android:textColor="@color/bb_sanct_on_surface_muted"
                            tools:text="Ends at 17:30" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ============ Controles: stop · pausa/play · saltar descanso ============ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/focusStopButton"
                    android:layout_width="@dimen/focus_sanct_ghost_size"
                    android:layout_height="@dimen/focus_sanct_ghost_size"
                    android:background="@drawable/bg_sanct_ghost"
                    android:contentDescription="@string/focus_stop"
                    android:padding="@dimen/focus_sanct_ghost_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_stop_24"
                    app:tint="@color/bb_sanct_sage_bright" />

                <ImageButton
                    android:id="@+id/focusPlayButton"
                    android:layout_width="@dimen/focus_sanct_play_box"
                    android:layout_height="@dimen/focus_sanct_play_box"
                    android:layout_marginStart="@dimen/focus_sanct_control_gap"
                    android:layout_marginEnd="@dimen/focus_sanct_control_gap"
                    android:background="@drawable/bg_sanct_play"
                    android:contentDescription="@string/focus_pause"
                    android:padding="@dimen/focus_sanct_play_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause_v2_filled_24"
                    app:tint="@color/bb_sanct_on_primary" />

                <ImageButton
                    android:id="@+id/focusSkipButton"
                    android:layout_width="@dimen/focus_sanct_ghost_size"
                    android:layout_height="@dimen/focus_sanct_ghost_size"
                    android:background="@drawable/bg_sanct_ghost"
                    android:contentDescription="@string/focus_skip_rest"
                    android:padding="@dimen/focus_sanct_ghost_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next_24"
                    app:tint="@color/bb_sanct_sage_bright" />
            </LinearLayout>

            <!-- html 01c: solo en descanso. -->
            <TextView
                android:id="@+id/focusRestHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_horizontal"
                android:text="@string/focus_rest_hint"
                android:textAppearance="@style/TextAppearance.BBetter.Label"
                android:textColor="@color/bb_sanct_on_surface_muted"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/spacing_md" />

            <!-- ============ Today / Streak (+ fallos de hoy) ============ -->
            <LinearLayout
                android:id="@+id/focusStatsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sanct_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/focus_sanct_card_padding_v"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/focus_sanct_card_padding_v">

                <LinearLayout
                    android:id="@+id/focusTodayColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_today"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        android:textColor="@color/bb_sanct_on_surface_muted" />

                    <TextView
                        android:id="@+id/focusTodayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/focus_stat_value_gap"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        android:textColor="@color/bb_sanct_on_surface"
                        android:textSize="@dimen/focus_sanct_stat_text"
                        tools:text="2h 14m" />

                    <!-- Contador de fallos (antes homeFailsChip, u13 → u14). -->
                    <TextView
                        android:id="@+id/focusFailsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        android:textColor="@color/bb_sanct_on_surface_faint"
                        tools:text="1 missed session" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/widget_hairline"
                    android:layout_height="match_parent"
                    android:background="@color/bb_sanct_divider" />

                <LinearLayout
                    android:id="@+id/focusStreakColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_streak"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        android:textColor="@color/bb_sanct_on_surface_muted" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/focus_stat_value_gap"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/focus_streak_flame_size"
                            android:layout_height="@dimen/focus_streak_flame_size"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flame_v2_24"
                            app:tint="@color/bb_sanct_primary" />

                        <TextView
                            android:id="@+id/focusStreakText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                            android:textColor="@color/bb_sanct_on_surface"
                            android:textSize="@dimen/focus_sanct_stat_text"
                            tools:text="6 weeks" />
                    </LinearLayout>

                    <!-- Días de esta semana frente al objetivo (racha semanal). -->
                    <TextView
                        android:id="@+id/focusStreakWeekText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        android:textColor="@color/bb_sanct_on_surface_faint"
                        tools:text="3/4 this week" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Studying now (maqueta social) ============ -->
            <!-- PLACEHOLDER(ui-placeholders#social-focus-studying) -->
            <LinearLayout
                android:id="@+id/focusSocialBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/focusStudyingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_xs">

                    <View
                        android:layout_width="@dimen/focus_sanct_chip_dot"
                        android:layout_height="@dimen/focus_sanct_chip_dot"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/bg_sanct_dot" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/focus_studying_now"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption"
                        android:textColor="@color/bb_sanct_on_surface" />

                    <TextView
                        android:id="@+id/focusStudyingMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_sanct_meta_pill"
                        android:fontFeatureSettings="tnum"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingTop="@dimen/focus_stat_value_gap"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/focus_stat_value_gap"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        android:textColor="@color/bb_sanct_on_surface_muted"
                        tools:text="5 / 8" />
                </LinearLayout>

                <!-- Rejilla de 4 columnas: FocusFragment.renderFriends la rellena con filas de
                     item_focus_friend (html 01b grid-cols-4 gap-y-2, sin caja). -->
                <LinearLayout
                    android:id="@+id/focusFriendsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

                <!-- F1-u4: estado «sin cuenta» (SocialFeature.isAccountEnabled + SIGNED_OUT).
                     Sustituye a la cabecera y la rejilla de arriba; toda la tarjeta lleva al
                     router social. -->
                <LinearLayout
                    android:id="@+id/focusNoAccountCta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sanct_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/social_cta_card_padding"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/social_cta_icon"
                        android:layout_height="@dimen/social_cta_icon"
                        android:background="@drawable/bg_social_cta_icon"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/social_cta_icon_padding"
                        android:src="@drawable/ic_group_add_24"
                        android:tint="@color/bb_sanct_sage_bright" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/social_cta_title"
                            android:textAppearance="@style/TextAppearance.BBetter.Title"
                            android:textColor="@color/bb_sanct_on_surface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/social_cta_body"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption"
                            android:textColor="@color/bb_sanct_on_surface_muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/spacing_md" />

            <!-- F2-u8: abre la hoja Invitar (con perfil) o el router (sin cuenta o sin perfil). -->
            <FrameLayout
                android:id="@+id/focusInviteButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/focus_sanct_invite_height"
                android:background="@drawable/bg_sanct_invite"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/focusInviteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawablePadding="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:text="@string/focus_invite_friends"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    android:textColor="@color/bb_sanct_on_surface"
                    app:drawableStartCompat="@drawable/ic_group_add_24"
                    app:drawableTint="@color/bb_sanct_on_surface_muted" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
