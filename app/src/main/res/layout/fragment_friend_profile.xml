<?xml version="1.0" encoding="utf-8"?>
<!-- F3-u6 · Friend profile (02 §9): avatar, name and @username, then the streak, this week against the goal,
     minutes this week, best streak and total. A friend with no stats yet gets a sentence, not zeros.
     No cheer control (F5, D-030). Remove and Report sit at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/friendProfileScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.social.FriendProfileFragment">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:id="@+id/fpScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.bbettercalendar.ui.common.widget.AvatarView
                    android:id="@+id/fpAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:avatarSize="@dimen/social_avatar_preview" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/fpName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Headline"
                        tools:text="Bob" />

                    <TextView
                        android:id="@+id/fpHandle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                        tools:text="\@bob" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/fpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/friend_profile_loading"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

            <TextView
                android:id="@+id/fpEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:padding="@dimen/social_friend_row_padding"
                android:text="@string/friend_profile_empty"
                android:textAppearance="@style/TextAppearance.BBetter.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/fpStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Weekly streak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/social_friend_row_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/friend_profile_streak_label"
                        android:textAppearance="@style/TextAppearance.BBetter.Label" />

                    <TextView
                        android:id="@+id/fpStreak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.BBetter.Stat"
                        tools:text="5 weeks" />
                </LinearLayout>

                <!-- This week against the goal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/social_friend_row_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/friend_profile_week_label"
                        android:textAppearance="@style/TextAppearance.BBetter.Label" />

                    <TextView
                        android:id="@+id/fpDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.BBetter.Stat"
                        tools:text="3 of 4 days" />

                    <LinearLayout
                        android:id="@+id/fpDots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/fpMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                        tools:text="310 min this week" />
                </LinearLayout>

                <!-- Best streak and total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="@dimen/social_friend_row_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/friend_profile_best_label"
                            android:textAppearance="@style/TextAppearance.BBetter.Label" />

                        <TextView
                            android:id="@+id/fpBest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.BBetter.Stat.Tile"
                            tools:text="9 weeks" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="@dimen/social_friend_row_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/friend_profile_total_label"
                            android:textAppearance="@style/TextAppearance.BBetter.Label" />

                        <TextView
                            android:id="@+id/fpTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.BBetter.Stat.Tile"
                            tools:text="25 h 10 min" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fpRemoveButton"
                style="@style/Widget.BBetter.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/friend_profile_remove" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fpReportButton"
                style="@style/Widget.BBetter.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/friend_profile_report" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
