<?xml version="1.0" encoding="utf-8"?>
<!-- Home (migración visual u13, .stitch/designs/04-home.png + .stitch/html/04-home.html).
     Header (avatar, saludo, fecha, campana) · tarjeta del temporizador · racha + amigos ·
     Tasks · Next up. La sesión en marcha ya NO se pinta aquí a pantalla completa (el antiguo
     "focus mode"): Play arranca la sesión y navega a navigation_focus; con una sesión viva la
     tarjeta muestra el restante y un toque abre Focus. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- ============ Header: avatar + saludo/fecha + campana ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.bbettercalendar.ui.common.widget.AvatarView
                android:id="@+id/homeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:avatarCutoutColor="@color/bb_surface"
                app:avatarPresenceDot="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Headline"
                    tools:text="Hi there" />

                <TextView
                    android:id="@+id/homeDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    tools:text="Saturday, Oct 3" />
            </LinearLayout>

            <!-- PLACEHOLDER(ui-placeholders#home-notification-centre): sin centro de notificaciones.
                 F2-u8: con perfil, el punto (homeBellDot) sale solo con solicitudes de amistad pendientes y
                 el toque abre Amigos en Solicitudes; sin cuenta o en release, punto fijo y aviso "pronto". -->
            <FrameLayout
                android:layout_width="@dimen/home_header_icon_button"
                android:layout_height="@dimen/home_header_icon_button">

                <ImageButton
                    android:id="@+id/homeBellButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_notifications"
                    android:padding="@dimen/spacing_sm"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notifications_empty_24"
                    app:tint="@color/bb_on_surface_muted" />

                <View
                    android:id="@+id/homeBellDot"
                    android:layout_width="@dimen/spacing_sm"
                    android:layout_height="@dimen/spacing_sm"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_progress_badge_dot"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ Timer card ============ -->
        <FrameLayout
            android:id="@+id/homeTimerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_home_timer_card"
            android:foreground="?attr/selectableItemBackground"
            android:padding="@dimen/home_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Mode chip: punto salvia + CONCENTRATION / REST -->
                <LinearLayout
                    android:id="@+id/homeModeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_mode_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_card_gap"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_card_gap"
                    android:paddingBottom="@dimen/spacing_xs">

                    <View
                        android:layout_width="@dimen/home_mode_dot_size"
                        android:layout_height="@dimen/home_mode_dot_size"
                        android:background="@drawable/bg_dot_primary" />

                    <TextView
                        android:id="@+id/homeTimerTypeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/home_mode_concentration"
                        android:textAppearance="@style/TextAppearance.BBetter.Chip"
                        android:textColor="@color/bb_on_primary_container" />
                </LinearLayout>

                <!-- Countdown -->
                <TextView
                    android:id="@+id/homeTimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.BBetter.Display"
                    android:textSize="@dimen/home_timer_text"
                    tools:text="25:00" />

                <!-- Play (idle) / abrir Focus (sesión viva) -->
                <ImageButton
                    android:id="@+id/homePlayButton"
                    android:layout_width="@dimen/home_play_button_size"
                    android:layout_height="@dimen/home_play_button_size"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="@string/home_play"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play_v2_filled_24"
                    app:tint="@color/bb_on_primary" />

                <!-- "Cycle x of N · Next: <task>" — abre la configuración del temporizador -->
                <LinearLayout
                    android:id="@+id/homeCycleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_home_cycle_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_card_gap">

                    <TextView
                        android:id="@+id/homeCycleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption"
                        android:textColor="@color/bb_on_surface"
                        tools:text="Cycle 0 of 4 · Next: Final thesis: chapter 3" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more_24"
                        app:tint="@color/bb_on_surface_muted" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ============ Racha + amigos estudiando ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Tap = FocusStreakPopup (como el antiguo botón de racha del saludo). -->
            <LinearLayout
                android:id="@+id/homeStreakButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:contentDescription="@string/home_streak_desc"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="14dp">

                <com.example.bbettercalendar.ui.common.widget.StreakWeekView
                    android:id="@+id/homeStreakWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:streakFlame="top" />
            </LinearLayout>

            <!-- Bloque social (maqueta tras FEATURE_SOCIAL_MOCK; GONE sin hueco con el flag apagado).
                 PLACEHOLDER(ui-placeholders#social-home-friends) -->
            <LinearLayout
                android:id="@+id/homeFriendsCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeFriendsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        android:textColor="@color/bb_on_surface"
                        tools:text="5 friends studying now" />

                    <View
                        android:id="@+id/homeFriendsDot"
                        android:layout_width="@dimen/spacing_sm"
                        android:layout_height="@dimen/spacing_sm"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:background="@drawable/bg_dot_primary" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/spacing_card_gap" />

                <LinearLayout
                    android:id="@+id/homeFriendsAvatars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeFriendsNames"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        tools:text="Laia, Pau, Marc" />
                </LinearLayout>

                <!-- F1-u4: estado «sin cuenta» (isAccountEnabled + SIGNED_OUT): sustituye a la
                     fila de avatares; la tarjeta entera lleva al router social. -->
                <TextView
                    android:id="@+id/homeFriendsJoin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/social_cta_button"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    android:textColor="@color/bb_primary_bright"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Tasks (spec tasks-home-today) ============ -->
        <LinearLayout
            android:id="@+id/homeTasksCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_tasks_card_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <ImageButton
                    android:id="@+id/homeAddTaskButton"
                    android:layout_width="@dimen/home_add_task_button"
                    android:layout_height="@dimen/home_add_task_button"
                    android:background="@drawable/bg_stepper_button"
                    android:contentDescription="@string/home_tasks_add"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/bb_primary_bright" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeTasksEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/home_tasks_empty"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeTodayTaskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/homeShowOverdueButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xs"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="@dimen/spacing_xs"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="40dp"
                android:text="@string/home_tasks_show_overdue"
                android:textAppearance="@style/TextAppearance.BBetter.Caption" />

            <LinearLayout
                android:id="@+id/homeOverdueSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/homeOverdueEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/home_tasks_overdue_empty"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeOverdueTaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Next up: siguiente evento (CalendarEntryDAO.getEventsBetween) ============ -->
        <LinearLayout
            android:id="@+id/homeNextUpCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:contentDescription="@string/home_next_up_desc"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="@dimen/home_next_up_icon_tile"
                android:layout_height="@dimen/home_next_up_icon_tile"
                android:background="@drawable/bg_home_icon_tile"
                android:importantForAccessibility="no"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_calendar_v2_24"
                app:tint="@color/bb_primary_bright" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/home_next_up"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.BBetter.Micro" />

                <TextView
                    android:id="@+id/homeNextUpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                    tools:text="17:30 Study group" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/bb_on_surface_muted" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
