<?xml version="1.0" encoding="utf-8"?>
<!-- Home (mejora-visual u6, M/40-home.png; antes migración visual u13, html 04).
     Header (avatar, saludo, fecha, campana) · tarjeta del temporizador con luz y halo ámbar (chip
     «Concentración · 2 de 4», cifra, botón de anillo vivo, «Ahora/Siguiente: <tarea>») · racha + amigos ·
     Hoy (cuenta, barra, filas con casilla y anillo pequeño, esqueleto, estado vacío) · A continuación.
     La sesión en marcha NO se pinta aquí a pantalla completa: Play arranca la sesión y navega a
     navigation_focus; con una sesión viva el botón y la tarjeta abren Focus. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- ============ Header: avatar + saludo/fecha + campana ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.bbettercalendar.ui.common.widget.AvatarView
                android:id="@+id/homeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:avatarCutoutColor="@color/bb_surface"
                app:avatarPresenceDot="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Headline"
                    tools:text="Hola, Guille" />

                <TextView
                    android:id="@+id/homeDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    tools:text="Miércoles, 11 nov" />
            </LinearLayout>

            <!-- F5-u7: con perfil, el punto (homeBellDot) sale solo con avisos sin leer en la bandeja o
                 solicitudes de amistad pendientes (sin numero) y el toque abre la bandeja; sin cuenta o en
                 release, punto fijo y aviso "pronto". -->
            <FrameLayout
                android:layout_width="@dimen/home_header_icon_button"
                android:layout_height="@dimen/home_header_icon_button">

                <ImageButton
                    android:id="@+id/homeBellButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_notifications"
                    android:padding="@dimen/spacing_sm"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notifications_empty_24"
                    app:tint="@color/bb_on_surface_muted" />

                <View
                    android:id="@+id/homeBellDot"
                    android:layout_width="@dimen/spacing_sm"
                    android:layout_height="@dimen/spacing_sm"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_progress_badge_dot"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ Timer card: luz tintada + halo ámbar (recortado por la tarjeta) ============ -->
        <FrameLayout
            android:id="@+id/homeTimerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card_lit_tinted"
            android:clipToPadding="false"
            android:foreground="?attr/selectableItemBackground"
            android:padding="@dimen/home_card_padding">

            <View
                android:id="@+id/homeTimerHalo"
                android:layout_width="@dimen/home_timer_halo_size"
                android:layout_height="@dimen/home_timer_halo_size"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/home_timer_halo_offset"
                android:layout_marginBottom="@dimen/home_timer_halo_offset"
                android:background="@drawable/bg_glow_amber"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Chip «● Concentración · 2 de 4»: abre la configuración del temporizador. -->
                <LinearLayout
                    android:id="@+id/homeCycleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_mode_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/home_chip_min_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">

                    <View
                        android:layout_width="@dimen/home_mode_dot_size"
                        android:layout_height="@dimen/home_mode_dot_size"
                        android:background="@drawable/bg_dot_primary" />

                    <TextView
                        android:id="@+id/homeTimerTypeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.BBetter.Label"
                        android:textColor="@color/bb_on_primary_container"
                        tools:text="Concentración · 2 de 4" />
                </LinearLayout>

                <!-- Countdown -->
                <TextView
                    android:id="@+id/homeTimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.BBetter.Display"
                    android:textSize="@dimen/home_timer_text"
                    tools:text="17:23" />

                <!-- Play con anillo vivo (D1): idle arranca y abre Focus; con sesión viva abre Focus. -->
                <com.example.bbettercalendar.ui.common.widget.RingButtonView
                    android:id="@+id/homePlayButton"
                    android:layout_width="@dimen/home_ring_button_size"
                    android:layout_height="@dimen/home_ring_button_size"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:contentDescription="@string/home_play"
                    app:ringVariant="primary" />

                <!-- «Ahora: <tarea>» (vinculada) o «Siguiente: <tarea>» (primera pendiente de hoy). -->
                <TextView
                    android:id="@+id/homeCycleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_horizontal"
                    android:textAppearance="@style/TextAppearance.BBetter.Body"
                    android:textColor="@color/bb_on_primary_container"
                    android:visibility="gone"
                    tools:text="Ahora: Repasar tema 4"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============ Racha + amigos estudiando ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Tap = FocusStreakPopup. «Racha» / «2 semanas» en ámbar / 7 días / «2 de 3 días». -->
            <LinearLayout
                android:id="@+id/homeStreakButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:contentDescription="@string/home_streak_desc"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/home_small_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_streak_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <TextView
                    android:id="@+id/homeStreakValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.BBetter.Title"
                    android:textColor="@color/bb_accent_reward"
                    tools:text="2 semanas" />

                <com.example.bbettercalendar.ui.home.WeekPillStripView
                    android:id="@+id/homeStreakStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <TextView
                    android:id="@+id/homeStreakGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    tools:text="2 de 3 días" />
            </LinearLayout>

            <!-- Amigos (datos reales de la instantánea; GONE sin hueco con el flag apagado). -->
            <LinearLayout
                android:id="@+id/homeFriendsCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/home_small_card_padding">

                <TextView
                    android:id="@+id/homeFriendsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_friends_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <!-- Avatares solapados (HomeFragment.renderFriends los añade). -->
                <LinearLayout
                    android:id="@+id/homeFriendsAvatars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/homeFriendsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                    android:textColor="@color/bb_primary_bright"
                    tools:text="2 estudiando ahora" />

                <!-- F4-u6: sin amigos todavía, una línea que invita. -->
                <TextView
                    android:id="@+id/homeFriendsNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Micro"
                    android:textColor="@color/bb_on_surface_muted"
                    android:visibility="gone" />

                <!-- F1-u4: estado «sin cuenta» (isAccountEnabled + SIGNED_OUT): sustituye a la
                     fila de avatares; la tarjeta entera lleva al router social. -->
                <TextView
                    android:id="@+id/homeFriendsJoin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/social_cta_button"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    android:textColor="@color/bb_primary_bright"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Hoy: cuenta + barra + filas (spec tasks-home-today) ============ -->
        <LinearLayout
            android:id="@+id/homeTasksCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_tasks_today"
                        android:textAppearance="@style/TextAppearance.BBetter.Title" />

                    <TextView
                        android:id="@+id/homeTasksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption"
                        android:visibility="gone"
                        tools:text="2 de 5 tareas"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/homeAddTaskButton"
                    android:layout_width="@dimen/home_tasks_add_size"
                    android:layout_height="@dimen/home_tasks_add_size"
                    android:background="@drawable/bg_home_add_button"
                    android:contentDescription="@string/home_tasks_add"
                    android:padding="@dimen/home_tasks_add_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/bb_primary_bright" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/homeTasksProgress"
                style="@style/Widget.BBetter.LinearProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card_gap"
                android:max="100"
                android:visibility="gone"
                tools:progress="40"
                tools:visibility="visible" />

            <!-- Hasta la primera emisión de tareas. -->
            <com.example.bbettercalendar.ui.common.widget.SkeletonGroup
                android:id="@+id/homeTasksSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:skeletonRows="3" />

            <com.example.bbettercalendar.ui.common.widget.EmptyStateView
                android:id="@+id/homeTasksEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:emptyActionText="@string/home_tasks_add"
                app:emptyMessage="@string/home_tasks_empty_message"
                app:emptyTitle="@string/home_tasks_empty_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeTodayTaskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/homeShowOverdueButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="@dimen/spacing_xs"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:text="@string/home_tasks_show_overdue"
                android:textAppearance="@style/TextAppearance.BBetter.Caption" />

            <LinearLayout
                android:id="@+id/homeOverdueSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/homeOverdueEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/home_tasks_overdue_empty"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeOverdueTaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ A continuación: siguiente evento (CalendarEntryDAO.getEventsBetween) ============ -->
        <LinearLayout
            android:id="@+id/homeNextUpCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:contentDescription="@string/home_next_up_desc"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/home_small_card_padding">

            <ImageView
                style="@style/Widget.BBetter.IconBox"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_timer_24"
                app:tint="@color/bb_primary_bright" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/homeNextUpLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/home_next_up"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    tools:text="A continuación · 16:30" />

                <TextView
                    android:id="@+id/homeNextUpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                    tools:text="Tutoría del TFG" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/bb_on_surface_muted" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
