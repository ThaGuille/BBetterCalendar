<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.home.HomeFragment">

    <!-- fillViewport + este LinearLayout en wrap_content es lo que hace posible el "focus mode"
         (spec focus-mode-and-streak): al pasar homeTimerCard a match_parent con el resto GONE, el
         ScrollView re-mide este hijo a la altura exacta del viewport y la tarjeta ocupa la
         pantalla entera sin necesidad de otro Fragment. -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- ============ Header strip ============ -->
        <LinearLayout
            android:id="@+id/homeHeaderSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.BBetter.Headline"
                android:textColor="@color/bb_primary_dark"
                tools:text="Hi there" />

            <!-- Fecha a la izquierda + tiempo estudiado hoy a la derecha, en la misma linea
                 (spec focus-mode-and-streak): sustituye a la tarjeta de stats de 3 columnas.
                 Los fallos solo aparecen si los hay. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/homeDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    tools:text="Tuesday, May 18" />

                <LinearLayout
                    android:id="@+id/homeFailsChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/home_inline_stat_icon_size"
                        android:layout_height="@dimen/home_inline_stat_icon_size"
                        android:contentDescription="@string/home_stat_fails_label"
                        android:src="@drawable/ic_cross_v2_24"
                        app:tint="@color/bb_danger" />

                    <TextView
                        android:id="@+id/homeToadyFailsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.BBetter.Label"
                        android:textColor="@color/bb_danger"
                        tools:text="2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/home_inline_stat_icon_size"
                        android:layout_height="@dimen/home_inline_stat_icon_size"
                        android:contentDescription="@string/home_stat_studied_label"
                        android:src="@drawable/ic_clock_v2_24"
                        app:tint="@color/bb_primary" />

                    <TextView
                        android:id="@+id/homeTodayTimeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:hint="@string/home_stat_studied_placeholder"
                        android:textAppearance="@style/TextAppearance.BBetter.Label"
                        android:textColor="@color/bb_on_surface"
                        tools:text="01:20" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ Timer card ============
             En reposo es una tarjeta mas; con el timer en marcha HomeFragment le pone
             height=match_parent y esconde el resto -> pantalla dedicada de concentracion. -->
        <FrameLayout
            android:id="@+id/homeTimerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:padding="@dimen/home_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Mode chip -->
                <TextView
                    android:id="@+id/homeTimerTypeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_energy"
                    android:gravity="center"
                    android:hint="@string/home_mode_concentration"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.BBetter.Chip"
                    android:textColor="@color/bb_on_primary"
                    android:textColorHint="@color/bb_on_primary" />

                <!-- "Focusing: <task>" banner (spec focus-attribution): visible mientras el timer
                     esta vinculado a una tarea/item. Tap = desvincular la sesion en curso. -->
                <TextView
                    android:id="@+id/homeFocusBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    android:textColor="@color/bb_primary"
                    android:visibility="gone"
                    tools:text="Focusing: Read chapter 3" />

                <!-- Countdown -->
                <TextView
                    android:id="@+id/homeTimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.BBetter.Display"
                    android:textColor="@color/bb_on_surface"
                    android:textSize="@dimen/text_display_compact"
                    tools:text="25:00" />

                <!-- Controles: [hueco simetrico] play/pause [cancelar]. El hueco existe solo para
                     que el boton grande siga centrado cuando aparece "cancelar" (focus mode). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/homeControlsSpacer"
                        android:layout_width="@dimen/home_secondary_button_size"
                        android:layout_height="@dimen/home_secondary_button_size"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/homePlayButton"
                        android:layout_width="@dimen/home_play_button_size"
                        android:layout_height="@dimen/home_play_button_size"
                        android:background="@drawable/bg_play_button"
                        android:clickable="true"
                        android:contentDescription="@string/home_play"
                        android:elevation="@dimen/elevation_floating"
                        android:focusable="true"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_v2_filled_24" />

                    <ImageButton
                        android:id="@+id/homeCancelButton"
                        android:layout_width="@dimen/home_secondary_button_size"
                        android:layout_height="@dimen/home_secondary_button_size"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:background="@drawable/bg_close_circle"
                        android:clickable="true"
                        android:contentDescription="@string/home_cancel_session"
                        android:focusable="true"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close_24"
                        android:visibility="gone"
                        app:tint="@color/bb_on_surface_muted"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Focus block-mode toggle: arms/disarms blocking every other app while the
                     concentration timer runs (see blocking/FocusBlockState.java). Editable en
                     cualquier momento, tambien a mitad de sesion (spec focus-mode-and-streak). -->
                <TextView
                    android:id="@+id/homeBlockModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_block_mode_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/home_block_mode"
                    android:textAppearance="@style/TextAppearance.BBetter.Chip"
                    android:textColor="@color/bb_on_primary" />

                <!-- Skip-rest button (only shown while resting) -->
                <TextView
                    android:id="@+id/homeSkipRestButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_chip_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/home_skip_rest"
                    android:textAppearance="@style/TextAppearance.BBetter.Chip"
                    android:textColor="@color/bb_on_primary"
                    android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>

        <!-- ============ Today tasks card (spec tasks-home-today) ============ -->
        <LinearLayout
            android:id="@+id/homeTasksCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical"
            android:padding="@dimen/home_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_tasks_card_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <ImageButton
                    android:id="@+id/homeAddTaskButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_tasks_add"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/bb_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeTasksEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/home_tasks_empty"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeTodayTaskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/homeShowOverdueButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                android:text="@string/home_tasks_show_overdue"
                android:textAppearance="@style/TextAppearance.BBetter.Label"
                android:textColor="@color/bb_primary" />

            <LinearLayout
                android:id="@+id/homeOverdueSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/homeOverdueEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/home_tasks_overdue_empty"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeOverdueTaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
