<?xml version="1.0" encoding="utf-8"?>
<!-- F5-u7 · Inbox (the Home bell): cheers, nudges and friend requests you received, newest first. Operate
     mode: the list is the screen. Unread rows carry a dot for this visit; there is never a count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inboxScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.social.InboxFragment">

    <include layout="@layout/view_top_bar" />

    <TextView
        android:id="@+id/inboxStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md"
        android:text="@string/inbox_loading"
        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inboxList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/inboxEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_md"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/inbox_empty_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_horizontal"
            android:text="@string/inbox_empty_body"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />
    </LinearLayout>
</LinearLayout>
