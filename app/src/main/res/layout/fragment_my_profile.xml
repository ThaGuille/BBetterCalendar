<?xml version="1.0" encoding="utf-8"?>
<!-- F1-u5 · My profile: avatar, edit name + colour, rename the @username (once, then every 30 days),
     sign out, delete account (F1-u7). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/myProfileScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.social.MyProfileFragment">

    <include layout="@layout/view_top_bar" />

    <TextView
        android:id="@+id/mpStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md"
        android:text="@string/my_profile_loading"
        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

    <ScrollView
        android:id="@+id/mpContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <com.example.bbettercalendar.ui.common.widget.AvatarView
                android:id="@+id/mpAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:avatarSize="@dimen/social_avatar_large" />

            <TextView
                android:id="@+id/mpName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="@style/TextAppearance.BBetter.Headline"
                tools:text="Laia" />

            <TextView
                android:id="@+id/mpHandle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                tools:text="@laia" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/my_profile_name_label"
                android:textAppearance="@style/TextAppearance.BBetter.Label" />

            <EditText
                android:id="@+id/mpNameInput"
                style="@style/Widget.BBetter.Social.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:hint="@string/create_profile_name_hint"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="30" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/my_profile_color_label"
                android:textAppearance="@style/TextAppearance.BBetter.Label" />

            <com.example.bbettercalendar.ui.social.AvatarColorPickerView
                android:id="@+id/mpColorPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/mpMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/TextAppearance.BBetter.SocialError"
                android:visibility="gone"
                tools:text="Changes saved." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mpSaveButton"
                style="@style/Widget.BBetter.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:enabled="false"
                android:text="@string/my_profile_save" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/my_profile_handle_section"
                android:textAppearance="@style/TextAppearance.BBetter.Title" />

            <TextView
                android:id="@+id/mpRenameHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                tools:text="You can change your username once right now." />

            <EditText
                android:id="@+id/mpRenameInput"
                style="@style/Widget.BBetter.Social.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/my_profile_rename_hint"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLength="21" />

            <TextView
                android:id="@+id/mpRenameStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/TextAppearance.BBetter.Caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mpRenameButton"
                style="@style/Widget.BBetter.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:enabled="false"
                android:text="@string/my_profile_rename_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mpSignOutButton"
                style="@style/Widget.BBetter.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/my_profile_sign_out" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mpDeleteButton"
                style="@style/Widget.BBetter.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/my_profile_delete" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
