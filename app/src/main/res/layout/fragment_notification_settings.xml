<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications screen (plan sistema-notificaciones, part D). Rows are inflated from view_notif_row by
     NotificationSettingsFragment into the section cards below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notifSettingsScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.notifications.NotificationSettingsFragment">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:id="@+id/notifSettingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notifStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notif_settings_off_message"
                        android:textAppearance="@style/TextAppearance.BBetter.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notifTurnOnButton"
                        style="@style/Widget.BBetter.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/notif_settings_turn_on" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.example.bbettercalendar.ui.common.widget.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerTitle="@string/notif_settings_section_reminders" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                app:contentPadding="0dp">

                <LinearLayout
                    android:id="@+id/notifRemindersRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.example.bbettercalendar.ui.common.widget.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerTitle="@string/notif_settings_section_focus" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                app:contentPadding="0dp">

                <LinearLayout
                    android:id="@+id/notifFocusRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.example.bbettercalendar.ui.common.widget.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerTitle="@string/notif_settings_section_daily" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                app:contentPadding="0dp">

                <LinearLayout
                    android:id="@+id/notifDailyRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.example.bbettercalendar.ui.common.widget.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerTitle="@string/notif_settings_section_weekly" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                app:contentPadding="0dp">

                <LinearLayout
                    android:id="@+id/notifWeeklyRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <com.example.bbettercalendar.ui.common.widget.SectionHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerTitle="@string/notif_settings_section_more" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                app:contentPadding="0dp">

                <LinearLayout
                    android:id="@+id/notifMoreRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
