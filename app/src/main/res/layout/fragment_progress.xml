<?xml version="1.0" encoding="utf-8"?>
<!-- Progress (migracion visual u17, .stitch/designs/13-progress-final.png + html/13).
     Titulo + escudo + compartir fijos arriba; el resto scrollea: Week/Month/Year + navegador de
     periodo, tarjeta de tiles, "Past 12 weeks", "See all", Screen time & blocking, Projects.
     El carrusel de graficos se movio a All progress (u18); la banda de uso que quedaba al final
     duplicaba la tarjeta de bloqueo y se quito (fallos-frente-a-stitch). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.progress.ProgressFragment">

    <!-- ============ Cabecera: titulo + escudo (Screen time) + compartir ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:id="@+id/progressTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline" />

        <FrameLayout
            android:id="@+id/progressShieldButton"
            android:layout_width="@dimen/progress_header_button"
            android:layout_height="@dimen/progress_header_button"
            android:background="@drawable/bg_progress_header_button"
            android:clickable="true"
            android:contentDescription="@string/progress_header_screen_time_cd"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_24"
                app:tint="@color/bb_primary_bright" />

            <!-- PLACEHOLDER(ui-placeholders#progress-new-badge): punto de "novedad" fijo. -->
            <View
                android:layout_width="@dimen/progress_header_badge_dot"
                android:layout_height="@dimen/progress_header_badge_dot"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_progress_badge_dot" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/progressShareButton"
            android:layout_width="@dimen/progress_header_button"
            android:layout_height="@dimen/progress_header_button"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/progress_header_share_cd"
            android:padding="@dimen/spacing_sm"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share_24"
            app:tint="@color/bb_on_surface_muted" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/progressScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/progress_bottom_clearance">

            <!-- ============ Week / Month / Year + navegador de periodo ============ -->
            <com.example.bbettercalendar.ui.common.widget.SegmentedControlView
                android:id="@+id/progressGranularity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.bbettercalendar.ui.common.widget.PeriodNavigatorView
                android:id="@+id/progressPeriodNavigator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card_gap" />

            <!-- ============ Tarjeta de tiles: Focus time / Sessions / Tasks done ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card_gap"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <com.example.bbettercalendar.ui.common.widget.StatTileView
                    android:id="@+id/progressTileFocus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:tileCard="false"
                    app:tileLabel="@string/progress_tile_focus_time" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/bb_divider" />

                <com.example.bbettercalendar.ui.common.widget.StatTileView
                    android:id="@+id/progressTileSessions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_card_gap"
                    android:layout_weight="1"
                    app:tileCard="false"
                    app:tileLabel="@string/progress_tile_sessions" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/bb_divider" />

                <!-- PLACEHOLDER(ui-placeholders#progress-tasks-done-approx): sin fecha de completado,
                     se cuentan las tareas hechas cuya fecha cae en el rango. -->
                <com.example.bbettercalendar.ui.common.widget.StatTileView
                    android:id="@+id/progressTileTasks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_card_gap"
                    android:layout_weight="1"
                    app:tileCard="false"
                    app:tileLabel="@string/progress_tile_tasks_done" />
            </LinearLayout>

            <!-- ============ Past 12 weeks ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_trend_title"
                            android:textAppearance="@style/TextAppearance.BBetter.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_trend_subtitle"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:text="@string/progress_trend_legend"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro"
                        app:drawableStartCompat="@drawable/ic_progress_legend_dash" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressTrendValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.Stat"
                        tools:text="148.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/progress_trend_unit"
                        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

                    <TextView
                        android:id="@+id/progressTrendDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                        android:textColor="@color/bb_primary_bright"
                        tools:text="+18.2 hrs vs prior" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/progressTrendChartHolder"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_trend_chart_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:contentDescription="@string/progress_trend_cd" />
            </LinearLayout>

            <!-- ============ See all your progress ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/progressSeeAll"
                style="@style/Widget.BBetter.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_see_all_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:minHeight="@dimen/progress_see_all_height"
                android:text="@string/progress_see_all"
                app:icon="@drawable/ic_arrow_forward_24"
                app:iconGravity="textEnd" />

            <!-- ============ Screen time & blocking ============ -->
            <LinearLayout
                android:id="@+id/progressBlockingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_progress_blocking_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/progress_blocking_icon_tile"
                        android:layout_height="@dimen/progress_blocking_icon_tile"
                        android:background="@drawable/bg_progress_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_shield_24"
                        app:tint="@color/bb_primary_bright" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/progress_blocking_title"
                                android:textAppearance="@style/TextAppearance.BBetter.Title" />

                            <!-- PLACEHOLDER(ui-placeholders#progress-new-badge): insignia fija. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:background="@drawable/bg_progress_new_badge"
                                android:paddingStart="@dimen/spacing_sm"
                                android:paddingTop="2dp"
                                android:paddingEnd="@dimen/spacing_sm"
                                android:paddingBottom="2dp"
                                android:text="@string/progress_blocking_new"
                                android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                                android:textColor="@color/bb_on_reward" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/progressBlockingSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption"
                            tools:text="1h 18m today · goal 1h 30m" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/progressBlockingGoalGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="vertical">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBlockingBar"
                        style="@style/Widget.BBetter.LinearProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        app:trackColor="@color/bb_surface_card"
                        app:trackThickness="8dp"
                        tools:progress="78" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/progressBlockingPercent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.BBetter.Micro"
                            tools:text="78% of daily limit" />

                        <TextView
                            android:id="@+id/progressBlockingRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                            android:textColor="@color/bb_on_surface"
                            tools:text="12m remaining" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/progressBlockingChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />

                <!-- PLACEHOLDER(ui-placeholders#progress-blocked-opens): no se cuentan aperturas bloqueadas. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_24"
                        app:tint="@color/bb_primary_bright" />

                    <TextView
                        android:id="@+id/progressBlockingOpens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption"
                        tools:text="23 opens blocked this week" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/progressManageBlocking"
                    style="@style/Widget.BBetter.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_blocking_cta_height"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:minHeight="@dimen/progress_blocking_cta_height"
                    android:text="@string/progress_blocking_manage"
                    app:icon="@drawable/ic_arrow_forward_24"
                    app:iconGravity="textEnd" />
            </LinearLayout>

            <!-- ============ Projects this week ============ -->
            <LinearLayout
                android:id="@+id/progressProjectsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressProjectsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/progress_projects_week"
                        android:textAppearance="@style/TextAppearance.BBetter.Title" />

                    <TextView
                        android:id="@+id/progressProjectsLogged"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        tools:text="8h 15m logged" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/progressProjectsRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
