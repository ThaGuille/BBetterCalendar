<?xml version="1.0" encoding="utf-8"?>
<!-- Progress (migracion visual u17, .stitch/designs/13-progress-final.png + html/13).
     Titulo + escudo + compartir fijos arriba; el resto scrollea: Week/Month/Year + navegador de
     periodo, tarjeta resumen (u7), "Ver todo tu progreso", "Tus apps" (u7), Proyectos.
     El carrusel de graficos y "Past 12 weeks" viven en All progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.progress.ProgressFragment">

    <!-- ============ Cabecera: titulo + escudo (Screen time) + compartir ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:id="@+id/progressTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline" />

        <FrameLayout
            android:id="@+id/progressShieldButton"
            android:layout_width="@dimen/progress_header_button"
            android:layout_height="@dimen/progress_header_button"
            android:background="@drawable/bg_progress_header_button"
            android:clickable="true"
            android:contentDescription="@string/progress_header_screen_time_cd"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_24"
                app:tint="@color/bb_primary_bright" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/progressShareButton"
            android:layout_width="@dimen/progress_header_button"
            android:layout_height="@dimen/progress_header_button"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/progress_header_share_cd"
            android:padding="@dimen/spacing_sm"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share_24"
            app:tint="@color/bb_on_surface_muted" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/progressScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/progress_bottom_clearance">

            <!-- ============ Week / Month / Year + navegador de periodo ============ -->
            <com.example.bbettercalendar.ui.common.widget.SegmentedControlView
                android:id="@+id/progressGranularity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.bbettercalendar.ui.common.widget.PeriodNavigatorView
                android:id="@+id/progressPeriodNavigator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card_gap" />

            <!-- ============ Tarjeta resumen (mejora-visual u7): Enfoque + mini barras, Sesiones / Tareas,
                 pie de constancia (plan racha-semanal-y-constancia) ============ -->
            <LinearLayout
                android:id="@+id/progressSummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <com.example.bbettercalendar.ui.common.widget.SkeletonGroup
                    android:id="@+id/progressSummarySkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_card_gap"
                    app:skeletonRowHeight="28dp"
                    app:skeletonRows="3" />

                <LinearLayout
                    android:id="@+id/progressSummaryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <com.example.bbettercalendar.ui.common.widget.StatTileView
                            android:id="@+id/progressSummaryFocus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:tileCard="false"
                            app:tileLabel="@string/progress_summary_focus" />

                        <com.example.bbettercalendar.ui.common.chart.SparkBarsView
                            android:id="@+id/progressSparkBars"
                            android:layout_width="@dimen/progress_spark_width"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:contentDescription="@string/progress_summary_spark_cd" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.example.bbettercalendar.ui.common.widget.StatTileView
                            android:id="@+id/progressSummarySessions"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:tileIcon="@drawable/ic_timer_24"
                            app:tileLabel="@string/progress_summary_sessions" />

                        <com.example.bbettercalendar.ui.common.widget.StatTileView
                            android:id="@+id/progressSummaryTasks"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_card_gap"
                            android:layout_weight="1"
                            app:tileIcon="@drawable/ic_check_24"
                            app:tileLabel="@string/progress_summary_tasks" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Constancia: una sola fila (etiqueta + "18/30 días" + delta | tira) para no
                     estirar la tarjeta. Sigue el selector Semana/Mes/Año. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_hairline"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:background="@color/bb_divider" />

                <LinearLayout
                    android:id="@+id/progressConsistencyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/progress_consistency_title"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/progressConsistencyValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                                tools:text="18/30 days" />

                            <TextView
                                android:id="@+id/progressConsistencyDelta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                                android:visibility="gone"
                                tools:text="+3"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.example.bbettercalendar.ui.common.widget.ConsistencyStripView
                        android:id="@+id/progressConsistencyStrip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ See all your progress ============ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/progressSeeAll"
                style="@style/Widget.BBetter.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_see_all_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:minHeight="@dimen/progress_see_all_height"
                android:text="@string/progress_see_all"
                app:icon="@drawable/ic_arrow_forward_24"
                app:iconGravity="textEnd" />

            <!-- ============ Tus apps (mejora-visual u7): toda la tarjeta abre Tiempo de pantalla ============ -->
            <LinearLayout
                android:id="@+id/progressAppsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:contentDescription="@string/progress_apps_cd"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_apps_title"
                            android:textAppearance="@style/TextAppearance.BBetter.Title" />

                        <TextView
                            android:id="@+id/progressAppsSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption"
                            tools:text="3 h 10 m al día · 22 % menos" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/bb_on_surface_muted" />
                </LinearLayout>

                <com.example.bbettercalendar.ui.common.widget.SkeletonGroup
                    android:id="@+id/progressAppsSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:skeletonRowHeight="28dp"
                    app:skeletonRows="3" />

                <LinearLayout
                    android:id="@+id/progressAppsRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/progressAppsHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:text="@string/progress_apps_hint"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============ Projects this week ============ -->
            <LinearLayout
                android:id="@+id/progressProjectsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressProjectsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/progress_projects_week"
                        android:textAppearance="@style/TextAppearance.BBetter.Title" />

                    <TextView
                        android:id="@+id/progressProjectsLogged"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        tools:text="8h 15m logged" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/progressProjectsRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
