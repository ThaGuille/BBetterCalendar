<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de proyecto (spec projects-mvp; u16: tarjetas bg_project_card + Widget.BBetter.Button.*): header editable (nombre/notas/deadline), lista de
     items y acciones de completar/borrar. Mismo patrón de scroll que fragment_home.xml. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.projects.ProjectDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- Volver a la lista (spec frontend-structure-cleanup): sustituye a la flecha Up de la
             ActionBar, que ya no existe. marginStart negativo: alinea el icono con el borde de la
             tarjeta en vez de con el área táctil de 48dp. -->
        <ImageButton
            android:id="@+id/projectDetailBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/bb_on_surface" />

        <!-- ============ Header card: name / notes / deadline ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_project_card"
            android:orientation="vertical"
            android:padding="@dimen/home_card_padding">

            <EditText
                android:id="@+id/projectDetailNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/create_project_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BBetter.Title" />

            <EditText
                android:id="@+id/projectDetailNotesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/create_project_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="6"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/projectDetailDeadlineButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:text="@string/create_project_set_deadline"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    android:textColor="@color/bb_primary_bright" />

                <TextView
                    android:id="@+id/projectDetailDeadlineChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_project_due_chip"
                    android:letterSpacing="0.05"
                    android:paddingStart="@dimen/project_chip_padding_h"
                    android:paddingTop="@dimen/project_chip_padding_v"
                    android:paddingEnd="@dimen/project_chip_padding_h"
                    android:paddingBottom="@dimen/project_chip_padding_v"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                    android:textSize="@dimen/project_chip_text"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!-- ============ Items card ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_project_card"
            android:orientation="vertical"
            android:padding="@dimen/home_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/project_detail_items_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <ImageButton
                    android:id="@+id/projectDetailAddItemButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/project_detail_add_item"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/bb_primary_bright" />
            </LinearLayout>

            <TextView
                android:id="@+id/projectDetailItemsEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/project_detail_items_empty"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/projectDetailItemsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

        <!-- ============ Actions ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectDetailCompleteButton"
                style="@style/Widget.BBetter.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/project_detail_complete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectDetailDeleteButton"
                style="@style/Widget.BBetter.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:text="@string/project_detail_delete" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
