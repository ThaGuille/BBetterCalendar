<?xml version="1.0" encoding="utf-8"?>
<!-- Projects (mejora-visual u11, mockup 30): titulo, resumen "3 activos · 1 vence esta semana" + racha,
     tarjetas de dos zonas (item_project.xml), seccion "Completados (N)" plegada y FAB extendido
     "Nuevo proyecto". Sin proyectos: EmptyStateView. La tarjeta fija de ritmo semanal se retiro (u11). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    tools:context=".ui.projects.ProjectsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/projectsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <TextView
                android:id="@+id/projectsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/projects_title"
                android:textAppearance="@style/TextAppearance.BBetter.Headline" />

            <!-- Resumen: "3 activos · 1 vence esta semana" + chip de racha. -->
            <LinearLayout
                android:id="@+id/projectsSummaryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_card_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/projectsSummaryText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    tools:text="3 activos · 1 vence esta semana" />

                <LinearLayout
                    android:id="@+id/projectsStreakChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="@drawable/bg_project_due_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/project_chip_padding_h"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/project_chip_padding_h"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_flame_v2_24"
                        app:tint="@color/bb_accent_reward" />

                    <TextView
                        android:id="@+id/projectsStreakText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        android:textColor="@color/bb_accent_reward"
                        tools:text="5 sem" />
                </LinearLayout>
            </LinearLayout>

            <com.example.bbettercalendar.ui.common.widget.EmptyStateView
                android:id="@+id/projectsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:emptyMessage="@string/projects_empty_message"
                app:emptyTitle="@string/projects_empty_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/projectsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- "Completados (N)": plegada; el toque despliega la lista de proyectos terminados. -->
            <LinearLayout
                android:id="@+id/projectsCompletedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_sm"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/projectsCompletedTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    tools:text="Completados (2)" />

                <ImageView
                    android:id="@+id/projectsCompletedChevron"
                    android:layout_width="@dimen/project_chevron_size"
                    android:layout_height="@dimen/project_chevron_size"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/bb_on_surface_muted" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/projectsCompletedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/projectsAddButton"
        style="@style/Widget.BBetter.FAB.Extended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_card_gap"
        android:contentDescription="@string/projects_add"
        android:text="@string/projects_new"
        app:icon="@drawable/ic_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
