<?xml version="1.0" encoding="utf-8"?>
<!-- Projects (rediseno-proyectos): the single screen. Toolbar, selector of active projects, then one list
     (summary R2, sort label, section cards, add-section button). The CoordinatorLayout lets the FAB rise
     with the snackbars. Without projects: the first-project state replaces everything but the title. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projectsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    tools:context=".ui.projects.ProjectsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/projectsToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm">

            <TextView
                android:id="@+id/projectsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/projects_title"
                android:textAppearance="@style/TextAppearance.BBetter.Headline" />

            <ImageButton
                android:id="@+id/projectsAgendaButton"
                style="@style/Widget.BBetter.ProjectsToolButton"
                android:contentDescription="@string/projects_main_agenda_desc"
                android:src="@drawable/ic_agenda_24"
                app:tint="@color/bb_on_surface" />

            <ImageButton
                android:id="@+id/projectsSortButton"
                style="@style/Widget.BBetter.ProjectsToolButton"
                android:contentDescription="@string/projects_main_sort_desc"
                android:src="@drawable/ic_sort_24"
                app:tint="@color/bb_on_surface" />

            <ImageButton
                android:id="@+id/projectsMenuButton"
                style="@style/Widget.BBetter.ProjectsToolButton"
                android:contentDescription="@string/projects_main_menu_desc"
                android:src="@drawable/ic_more_vert_24"
                app:tint="@color/bb_on_surface" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projectsSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_projects_selector_bubble" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projectsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="88dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- No projects at all: sprout, the spec text and the create button. -->
        <LinearLayout
            android:id="@+id/projectsFirstState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/projects_main_empty_icon"
                android:layout_height="@dimen/projects_main_empty_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sprout_48" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/projects_main_first_title"
                android:textAppearance="@style/TextAppearance.BBetter.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/projects_main_first_message"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectsCreateFirst"
                style="@style/Widget.BBetter.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/projects_main_first_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- One-line completion note; sits above the "Completed" snackbar. -->
    <LinearLayout
        android:id="@+id/projectsNoteBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/projects_main_note_bar_lift"
        android:background="@drawable/bg_projects_note_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_xs"
        android:visibility="gone">

        <EditText
            android:id="@+id/projectsNoteInput"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/projects_main_note_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.Body"
            android:textColorHint="@color/bb_on_surface_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/projectsNoteDone"
            style="@style/Widget.BBetter.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/projects_main_note_done" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/projectsFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_md"
        android:contentDescription="@string/projects_main_fab_desc"
        app:srcCompat="@drawable/ic_add_24" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
