<?xml version="1.0" encoding="utf-8"?>
<!-- Projects (u16, .stitch/designs/03-projects.png + html/03-projects.html): titulo, resumen
     ("4 active - 2 due this week" + racha), tarjetas desplegables, tarjeta de ritmo semanal
     (PLACEHOLDER(ui-placeholders#projects-weekly-rhythm)) y FAB. El titulo no lleva flecha atras ni
     filtro: es una pestana raiz (ver notes/u16.md). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    tools:context=".ui.projects.ProjectsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/projectsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <TextView
                android:id="@+id/projectsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/projects_title"
                android:textAppearance="@style/TextAppearance.BBetter.Headline" />

            <!-- Resumen: "4 active · 2 due this week" + chip de racha. -->
            <LinearLayout
                android:id="@+id/projectsSummaryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_card_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_xs">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_dot_primary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/projectsSummaryText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    tools:text="4 active · 2 due this week" />

                <LinearLayout
                    android:id="@+id/projectsStreakChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_project_due_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingEnd="10dp"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_flame_v2_24"
                        app:tint="@color/bb_accent_reward" />

                    <TextView
                        android:id="@+id/projectsStreakText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        android:textColor="@color/bb_accent_reward"
                        tools:text="5d streak" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/projectsEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/projects_empty"
                android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/projectsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Tarjeta de ritmo semanal (html 03): PLACEHOLDER(ui-placeholders#projects-weekly-rhythm). -->
            <LinearLayout
                android:id="@+id/projectsRhythmCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_project_card_expanded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/project_card_padding">

                <ImageView
                    android:layout_width="@dimen/project_insight_icon"
                    android:layout_height="@dimen/project_insight_icon"
                    android:background="@drawable/bg_project_due_chip"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_eco_24"
                    app:tint="@color/bb_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_card_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/projects_rhythm_title"
                        android:textAppearance="@style/TextAppearance.BBetter.Label"
                        android:textColor="@color/bb_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/projects_rhythm_subtitle"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/bb_divider" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/projectsAddButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_card_gap"
        android:contentDescription="@string/projects_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add_24" />

</androidx.constraintlayout.widget.ConstraintLayout>
