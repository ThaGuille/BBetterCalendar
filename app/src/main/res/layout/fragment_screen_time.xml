<?xml version="1.0" encoding="utf-8"?>
<!-- Screen time (mejora-visual u9; mockups 20 and 21). Top bar fixed, then a scroll:
     (1) focus shield + "N apps always allowed", (2) Week / Month, (3) usage per app,
     (4) day by day, (5) before and after the limit, (6) always allowed, (7) permissions footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screenTimeScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bb_surface"
    android:orientation="vertical"
    tools:context=".ui.screentime.ScreenTimeFragment">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:id="@+id/screenTimeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <!-- ============ 1. Focus shield ============ -->
            <LinearLayout
                android:id="@+id/screenTimeShieldCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_lit_tinted"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/screen_time_icon_tile"
                        android:layout_height="@dimen/screen_time_icon_tile"
                        android:background="@drawable/bg_screen_time_icon_tile"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_shield_24"
                        app:tint="@color/bb_primary_bright" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/screen_time_shield_title"
                            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/screen_time_shield_desc"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/screenTimeShieldSwitch"
                        style="@style/Widget.BBetter.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:contentDescription="@string/screen_time_shield_title"
                        android:thumb="@drawable/bb_switch_thumb_check" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/screen_time_hairline"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:background="@color/bb_divider" />

                <LinearLayout
                    android:id="@+id/screenTimeAllowedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/screenTimeAllowedCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption"
                        tools:text="4 apps siempre permitidas" />

                    <TextView
                        android:id="@+id/screenTimeAllowedEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/screen_time_allowed_edit"
                        android:textAppearance="@style/TextAppearance.BBetter.ChipLabel"
                        android:textColor="@color/bb_primary_bright" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 2. Week / Month ============ -->
            <com.example.bbettercalendar.ui.common.widget.SegmentedControlView
                android:id="@+id/screenTimePeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_time_card_gap"
                app:segmentEntries="@array/screen_time_periods"
                app:segmentSelected="0" />

            <!-- ============ 3. Usage per app ============ -->
            <LinearLayout
                android:id="@+id/screenTimeUsageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_time_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_usage_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <TextView
                    android:id="@+id/screenTimeUsageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    tools:text="Media diaria · esta semana" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/screenTimeAvgValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Stat"
                        tools:text="3 h 10 m" />

                    <TextView
                        android:id="@+id/screenTimeAvgDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:background="@drawable/bg_screen_time_delta_pill"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:paddingBottom="2dp"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                        android:visibility="gone"
                        tools:text="▼ 22 %"
                        tools:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/screenTimeAppRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/screenTimeAppsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    android:visibility="gone"
                    tools:text="@string/screen_time_usage_empty" />

                <TextView
                    android:id="@+id/screenTimeUsageLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:text="@string/screen_time_usage_legend"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/screenTimeBlockNew"
                    style="@style/Widget.BBetter.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/screen_time_button_height"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:minHeight="@dimen/screen_time_button_height"
                    android:text="@string/screen_time_limit_other"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <!-- ============ 4. Day by day ============ -->
            <LinearLayout
                android:id="@+id/screenTimeDailyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_time_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_daily_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_daily_subtitle"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <com.example.bbettercalendar.ui.common.chart.StackedBarsView
                    android:id="@+id/screenTimeDailyChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/screen_time_stacked_height"
                    android:layout_marginTop="@dimen/spacing_sm" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/screenTimeDailyLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:chipSpacingHorizontal="@dimen/spacing_card_gap"
                    app:chipSpacingVertical="@dimen/spacing_xs" />

                <LinearLayout
                    android:id="@+id/screenTimeDailySentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:background="@drawable/bg_screen_time_sentence"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_card_gap"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info_24"
                        app:tint="@color/bb_accent_reward" />

                    <TextView
                        android:id="@+id/screenTimeDailySentenceText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Body"
                        tools:text="El sábado es tu día de más móvil: 4 h 30 m." />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 5. Before and after the limit ============ -->
            <LinearLayout
                android:id="@+id/screenTimeBeforeAfterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_time_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_ba_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_ba_subtitle"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <LinearLayout
                    android:id="@+id/screenTimeBeforeAfterRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/screenTimeBeforeAfterEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:text="@string/screen_time_ba_empty"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/screenTimeBeforeAfterLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="@dimen/screen_time_legend_dot"
                        android:layout_height="@dimen/screen_time_legend_dot"
                        android:background="@drawable/bg_dot_primary"
                        android:backgroundTint="@color/bb_on_surface_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/screen_time_ba_before"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro" />

                    <View
                        android:layout_width="@dimen/screen_time_legend_dot"
                        android:layout_height="@dimen/screen_time_legend_dot"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:background="@drawable/bg_dot_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/screen_time_ba_after"
                        android:textAppearance="@style/TextAppearance.BBetter.Micro" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/screenTimeBeforeAfterSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    android:background="@drawable/bg_screen_time_sentence"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_card_gap"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info_24"
                        app:tint="@color/bb_accent_reward" />

                    <TextView
                        android:id="@+id/screenTimeBeforeAfterSentenceText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_card_gap"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.BBetter.Body"
                        tools:text="Has recuperado 1 h 16 m al día desde que pusiste límites." />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 6. Always allowed (u10: one chip per FocusAllowlist app, then "Add") ============ -->
            <LinearLayout
                android:id="@+id/screenTimeAllowedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_time_card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_allowed_title"
                    android:textAppearance="@style/TextAppearance.BBetter.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_time_allowed_subtitle"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/screenTimeAllowedChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card_gap"
                    app:chipSpacingHorizontal="@dimen/spacing_sm"
                    app:chipSpacingVertical="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/screenTimeAllowedAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_screen_time_add_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingEnd="@dimen/spacing_md"
                        android:text="@string/screen_time_allowed_add"
                        android:textAppearance="@style/TextAppearance.BBetter.ChipLabel"
                        android:textColor="@color/bb_primary_bright" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- ============ 7. Pie de permisos ============ -->
            <LinearLayout
                android:id="@+id/screenTimeFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_time_card_gap"
                android:background="@drawable/bg_screen_time_footer"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/screenTimeFooterIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check_24"
                    app:tint="@color/bb_primary_bright" />

                <TextView
                    android:id="@+id/screenTimeFooterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.BBetter.Micro"
                    tools:text="Usage access granted · Accessibility service active" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
