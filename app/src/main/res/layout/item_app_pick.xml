<?xml version="1.0" encoding="utf-8"?>
<!-- u23: fila del selector de apps con el estilo de lista de Screen time (bg_app_row =
     surface-container-high redondeado, como AppUsageRowView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginTop="@dimen/app_pick_row_gap"
    android:layout_marginEnd="@dimen/spacing_md"
    android:background="@drawable/bg_app_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="@dimen/widget_row_padding">

    <ImageView
        android:id="@+id/app_pick_icon"
        android:layout_width="@dimen/app_pick_icon_size"
        android:layout_height="@dimen/app_pick_icon_size"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/app_pick_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong" />

        <!-- u10: sugerencia inicial de "siempre permitidas" (marcador, mapas); visible solo entonces. -->
        <TextView
            android:id="@+id/app_pick_suggested"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_progress_suggested_pill"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="2dp"
            android:text="@string/app_picker_suggested"
            android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
            android:textColor="@color/bb_accent_reward"
            android:visibility="gone" />
    </LinearLayout>

    <!-- u14: casilla animada de la app (Widget.BBetter.CheckBox); la fila entera es el área de toque. -->
    <CheckBox
        android:id="@+id/app_pick_check"
        style="@style/Widget.BBetter.CheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/checkbox_overhang"
        android:layout_marginEnd="@dimen/checkbox_overhang"
        android:clickable="false"
        android:contentDescription="@string/app_picker_check"
        android:focusable="false" />

</LinearLayout>
