<?xml version="1.0" encoding="utf-8"?>
<!-- L-u10 · A blocked person: avatar, name, @username and Unblock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blockedRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/social_friend_row_padding">

    <com.example.bbettercalendar.ui.common.widget.AvatarView
        android:id="@+id/blockedAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:avatarSize="@dimen/social_friend_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_card_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/blockedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
            tools:text="Bob" />

        <TextView
            android:id="@+id/blockedHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
            tools:text="\@bob" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/blockedUnblock"
        style="@style/Widget.BBetter.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:text="@string/block_unblock" />
</LinearLayout>
