<?xml version="1.0" encoding="utf-8"?>
<!-- Una tarjeta del carrusel de gráficos. El gráfico (LineChart/BarChart) se crea en código
     y se añade a chart_container. Sin título propio: lo da la pestaña de encima (TabLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:background="@drawable/bg_card"
    android:elevation="@dimen/elevation_card"
    android:orientation="vertical"
    android:padding="@dimen/home_card_padding">

    <FrameLayout
        android:id="@+id/chart_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
