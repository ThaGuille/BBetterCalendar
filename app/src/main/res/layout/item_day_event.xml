<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la agenda del dia (mejora-visual u12): hora + barra de color + titulo + "Evento · 2 h". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="top"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_sm">

    <TextView
        android:id="@+id/eventTime"
        android:layout_width="@dimen/calendar_agenda_time_width"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.BBetter.Caption" />

    <View
        android:id="@+id/eventColorSwatch"
        android:layout_width="@dimen/calendar_agenda_bar_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/spacing_md"
        android:background="@drawable/bg_calendar_agenda_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong" />

        <TextView
            android:id="@+id/eventMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.BBetter.Caption" />
    </LinearLayout>

</LinearLayout>
