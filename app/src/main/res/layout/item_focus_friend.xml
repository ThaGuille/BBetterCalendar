<?xml version="1.0" encoding="utf-8"?>
<!-- u14 · Focus "Studying now" cell (Sanctuary html 01b since 2026-10-14): 36dp avatar (sage ring when studying, crown for the
     top earner) · name (text-xs medium, Mist) · time today (11px medium Sage, tabular) or "away".
     Away cells are drawn at 40 % by FocusFragment (the whole cell, html opacity-40). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.example.bbettercalendar.ui.common.widget.AvatarView
        android:id="@+id/focusFriendAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        app:avatarCutoutColor="@color/bb_sanct_surface"
        app:avatarSize="@dimen/focus_sanct_avatar_size" />

    <TextView
        android:id="@+id/focusFriendName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Caption"
        android:textColor="@color/bb_sanct_on_surface"
        tools:text="Laia" />

    <TextView
        android:id="@+id/focusFriendTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Micro"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/bb_sanct_sage_bright"
        tools:text="3:12:05" />
</LinearLayout>
