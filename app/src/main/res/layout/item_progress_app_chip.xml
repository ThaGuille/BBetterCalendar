<?xml version="1.0" encoding="utf-8"?>
<!-- u17 · Progress: app chip of the Screen time & blocking card (html 13: name + dot / lock, then usage). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_progress_app_tile"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/progressChipName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
            android:textColor="@color/bb_on_surface"
            tools:text="Instagram" />

        <View
            android:id="@+id/progressChipDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_progress_badge_dot" />

        <ImageView
            android:id="@+id/progressChipLock"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock_24"
            android:visibility="gone"
            app:tint="@color/bb_danger" />
    </LinearLayout>

    <TextView
        android:id="@+id/progressChipUsage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
        tools:text="42m" />
</LinearLayout>
