<?xml version="1.0" encoding="utf-8"?>
<!-- mejora-visual u7 · Progress: fila de la tarjeta "Tus apps" (icono real, nombre, candado, Sugerida, valor, barra). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/progressAppIcon"
        android:layout_width="@dimen/progress_apps_icon"
        android:layout_height="@dimen/progress_apps_icon"
        android:background="@drawable/bg_progress_icon_tile"
        android:importantForAccessibility="no"
        android:padding="@dimen/spacing_sm"
        tools:src="@drawable/ic_shield_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_card_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/progressAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                tools:text="Vídeos" />

            <ImageView
                android:id="@+id/progressAppLock"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@string/progress_apps_lock_cd"
                android:src="@drawable/ic_lock_24"
                android:visibility="gone"
                app:tint="@color/bb_on_surface_muted" />

            <TextView
                android:id="@+id/progressAppSuggested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_progress_suggested_pill"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="2dp"
                android:text="@string/progress_apps_suggested"
                android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                android:textColor="@color/bb_accent_reward"
                android:visibility="gone" />

            <TextView
                android:id="@+id/progressAppValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_card_gap"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.BBetter.Caption"
                tools:text="52 m / 1 h" />
        </LinearLayout>

        <com.example.bbettercalendar.ui.common.chart.LimitBarView
            android:id="@+id/progressAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
