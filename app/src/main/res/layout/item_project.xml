<?xml version="1.0" encoding="utf-8"?>
<!-- mejora-visual u11 (mockup 30) · Tarjeta de proyecto con dos zonas:
     projectCardTop = halo del color del proyecto + anillo con % + nombre + "4 de 9 tareas · 6 h 20 m" + chip de
     vencimiento + cheuron + "Siguiente tarea" / Enfocar; tocar la zona abre el detalle.
     projectCardStrip = ExpandStripView (bb_surface_raised, fondo plano: el redondeo lo da el clip de la tarjeta)
     con las tareas pendientes (casilla + play pequeño) y "Anadir tarea"; solo despliega, no navega. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projectCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/project_card_gap"
    android:background="@drawable/bg_card_lit"
    android:clipToOutline="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/projectCardTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <View
            android:id="@+id/projectGlow"
            android:layout_width="@dimen/project_glow_size"
            android:layout_height="@dimen/project_glow_size"
            android:layout_marginStart="@dimen/project_glow_offset"
            android:layout_marginTop="@dimen/project_glow_offset"
            android:background="@drawable/bg_glow_sage"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/project_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.bbettercalendar.ui.common.widget.ProgressRingView
                    android:id="@+id/projectRing"
                    android:layout_width="@dimen/project_ring_size"
                    android:layout_height="@dimen/project_ring_size"
                    app:ringStroke="@dimen/project_ring_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_card_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/projectNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BBetter.Title"
                        tools:text="Trabajo de fin de grado" />

                    <TextView
                        android:id="@+id/projectTasksText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption"
                        tools:text="4 de 9 tareas · 6 h 20 m" />

                    <TextView
                        android:id="@+id/projectDeadlineChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_project_due_chip"
                        android:paddingStart="@dimen/project_chip_padding_h"
                        android:paddingTop="@dimen/project_chip_padding_v"
                        android:paddingEnd="@dimen/project_chip_padding_h"
                        android:paddingBottom="@dimen/project_chip_padding_v"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                        tools:text="Vence en 3 días" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/projectChevron"
                    android:layout_width="@dimen/project_chevron_size"
                    android:layout_height="@dimen/project_chevron_size"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/bb_on_surface_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/projectNextRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/project_next_task"
                        android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                    <TextView
                        android:id="@+id/projectNextTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.BBetter.Body.Medium"
                        android:textColor="@color/bb_on_surface"
                        tools:text="Maquetar la portada" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/projectFocusButton"
                    style="@style/Widget.BBetter.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/project_focus_button_height"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:minHeight="@dimen/project_focus_button_height"
                    android:text="@string/project_focus_action"
                    app:icon="@drawable/ic_play_v2_filled_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.example.bbettercalendar.ui.common.widget.ExpandStripView
        android:id="@+id/projectCardStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
