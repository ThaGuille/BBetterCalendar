<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/projects_agenda_row_min_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/agendaRowTime"
        android:layout_width="@dimen/projects_agenda_time_width"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

    <TextView
        android:id="@+id/agendaRowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.BBetter.Body" />

    <TextView
        android:id="@+id/agendaRowDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.BBetter.Caption" />

    <ImageView
        android:id="@+id/agendaRowLock"
        android:layout_width="@dimen/projects_agenda_icon_size"
        android:layout_height="@dimen/projects_agenda_icon_size"
        android:layout_marginStart="@dimen/spacing_sm"
        android:contentDescription="@string/projects_agenda_block_desc"
        android:src="@drawable/ic_lock_24"
        app:tint="@color/bb_on_surface_muted" />
</LinearLayout>
