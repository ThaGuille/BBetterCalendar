<?xml version="1.0" encoding="utf-8"?>
<!-- mejora-visual u11 (mockup 31) · Fila de tarea del detalle de proyecto: casilla, titulo (tachado si esta
     hecha) con "40 / 120 min" o "Sin objetivo de tiempo" debajo y play redondo (solo las pendientes). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <CheckBox
        android:id="@+id/projectItemDoneCheckbox"
        style="@style/Widget.BBetter.CheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/checkbox_overhang"
        android:layout_marginEnd="@dimen/checkbox_overhang" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_card_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projectItemTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.BBetter.Body.Medium"
            android:textColor="@color/bb_on_surface"
            tools:text="Maquetar la portada" />

        <TextView
            android:id="@+id/projectItemProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.BBetter.Caption"
            tools:text="0 / 30 min" />
    </LinearLayout>

    <ImageView
        android:id="@+id/projectItemFocusButton"
        android:layout_width="@dimen/project_play_size"
        android:layout_height="@dimen/project_play_size"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="@drawable/bg_project_play"
        android:clickable="true"
        android:contentDescription="@string/task_focus_this_desc"
        android:focusable="true"
        android:padding="@dimen/project_play_icon_pad"
        android:src="@drawable/ic_play_v2_filled_24"
        app:tint="@color/bb_primary" />

</LinearLayout>
