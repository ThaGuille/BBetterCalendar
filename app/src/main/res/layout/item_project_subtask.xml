<?xml version="1.0" encoding="utf-8"?>
<!-- u16 · Subtarea dentro de una tarjeta de proyecto (html 03): circulo de check (reusa los
     drawables de tarea de Home), titulo (tachado y atenuado si esta hecha) y "25m" / "2 Pomodoros". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/projectSubtaskCheck"
        android:layout_width="@dimen/home_task_check_size"
        android:layout_height="@dimen/home_task_check_size"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_task_check_off"
        tools:src="@drawable/bg_task_check_on" />

    <TextView
        android:id="@+id/projectSubtaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_card_gap"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Body"
        android:textSize="@dimen/project_subtask_text"
        tools:text="Write 3.1 Methods" />

    <TextView
        android:id="@+id/projectSubtaskMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.BBetter.Micro"
        tools:text="2 Pomodoros" />
</LinearLayout>
