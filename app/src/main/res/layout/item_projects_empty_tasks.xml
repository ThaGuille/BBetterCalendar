<?xml version="1.0" encoding="utf-8"?>
<!-- rediseno-proyectos: a project without tasks: sprout, the spec text and the add-task button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_lg">

    <ImageView
        android:layout_width="@dimen/projects_main_empty_icon"
        android:layout_height="@dimen/projects_main_empty_icon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sprout_48" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/projects_main_ready_title"
        android:textAppearance="@style/TextAppearance.BBetter.Title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center"
        android:text="@string/projects_main_ready_message"
        android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/projectsAddFirstTask"
        style="@style/Widget.BBetter.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/projects_main_ready_button" />
</LinearLayout>
