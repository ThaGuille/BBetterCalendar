<?xml version="1.0" encoding="utf-8"?>
<!-- rediseno-proyectos: one project of the selector: bubble (ring, icon, badge) and its short name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/projects_main_selector_item"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_xs">

    <com.example.bbettercalendar.ui.common.widget.ProjectBubbleView
        android:id="@+id/projectsBubble"
        android:layout_width="@dimen/widget_bubble_view"
        android:layout_height="@dimen/widget_bubble_view" />

    <TextView
        android:id="@+id/projectsBubbleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_xs"
        android:textAppearance="@style/TextAppearance.BBetter.ProjectsCaption"
        tools:text="Tesis final" />
</LinearLayout>
