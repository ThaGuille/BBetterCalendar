<?xml version="1.0" encoding="utf-8"?>
<!-- rediseno-proyectos: one subtask under an expanded task row: small check (14dp box, 48dp target) + title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal">

    <com.example.bbettercalendar.ui.common.widget.TaskCheckView
        android:id="@+id/projectsSubtaskCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:checkSmall="true" />

    <TextView
        android:id="@+id/projectsSubtaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="@dimen/spacing_md"
        android:textAppearance="@style/TextAppearance.BBetter.Body"
        tools:text="Segundo paso" />
</LinearLayout>
