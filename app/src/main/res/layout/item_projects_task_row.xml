<?xml version="1.0" encoding="utf-8"?>
<!-- rediseno-proyectos: one task row [check] [title + icon row] [side], with the subtasks under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/projects_main_row_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_xs">

        <com.example.bbettercalendar.ui.common.widget.TaskCheckView
            android:id="@+id/projectsTaskCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/projectsTaskBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_xs">

            <TextView
                android:id="@+id/projectsTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.BBetter.Body.Medium"
                tools:text="Escribir el capítulo 3" />

            <LinearLayout
                android:id="@+id/projectsTaskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/projectsTaskWhen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.BBetter.ProjectsCaption"
                    tools:text="Hoy · 17:00" />

                <ImageView
                    android:id="@+id/projectsTaskIconDuration"
                    android:layout_width="@dimen/projects_main_meta_icon"
                    android:layout_height="@dimen/projects_main_meta_icon"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@string/projects_main_icon_duration"
                    android:src="@drawable/ic_hourglass_bottom_24"
                    app:tint="@color/bb_on_surface_muted" />

                <ImageView
                    android:id="@+id/projectsTaskIconRepeat"
                    android:layout_width="@dimen/projects_main_meta_icon"
                    android:layout_height="@dimen/projects_main_meta_icon"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@string/projects_main_icon_repeat"
                    android:src="@drawable/ic_repeat_24"
                    app:tint="@color/bb_on_surface_muted" />

                <ImageView
                    android:id="@+id/projectsTaskIconReminder"
                    android:layout_width="@dimen/projects_main_meta_icon"
                    android:layout_height="@dimen/projects_main_meta_icon"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@string/projects_main_icon_reminder"
                    android:src="@drawable/ic_bell_24"
                    app:tint="@color/bb_on_surface_muted" />

                <ImageView
                    android:id="@+id/projectsTaskIconLock"
                    android:layout_width="@dimen/projects_main_meta_icon"
                    android:layout_height="@dimen/projects_main_meta_icon"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@string/projects_main_icon_lock"
                    android:src="@drawable/ic_lock_24"
                    app:tint="@color/bb_on_surface_muted" />

                <ImageView
                    android:id="@+id/projectsTaskIconNote"
                    android:layout_width="@dimen/projects_main_meta_icon"
                    android:layout_height="@dimen/projects_main_meta_icon"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@string/projects_main_icon_note"
                    android:src="@drawable/ic_note_24"
                    app:tint="@color/bb_on_surface_muted" />

                <!-- Tag: its icon in its colour; a tap expands it into a pill with the name (48dp target). -->
                <LinearLayout
                    android:id="@+id/projectsTaskTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="@dimen/touch_target_min"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/projectsTaskTagPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_xs">

                        <ImageView
                            android:id="@+id/projectsTaskTagIcon"
                            android:layout_width="@dimen/projects_main_meta_icon"
                            android:layout_height="@dimen/projects_main_meta_icon"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/projectsTaskTagName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:layout_marginEnd="@dimen/spacing_xs"
                            android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.example.bbettercalendar.ui.common.widget.FocusTimerButton
            android:id="@+id/projectsTaskFocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.example.bbettercalendar.ui.projects.list.SubtaskCountView
            android:id="@+id/projectsTaskSubtasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/projectsTaskSubtaskList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/projects_main_subtask_indent"
        android:visibility="gone" />
</LinearLayout>
