<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de tareas de Home (spec tasks-home-today; u13 html 04): círculo de hecho +
     título en UNA línea + chip de proyecto, separadas por un hairline. El progreso "X/Ym" y la
     hora van en una línea secundaria bajo el título (en la fila partían el título en dos). El tachado/atenuado de las hechas, el
     separador de la primera fila y el color del chip los aplica TodayTaskAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/taskDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_hairline"
        android:background="@color/bb_divider" />

    <LinearLayout
        android:id="@+id/taskRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <CheckBox
            android:id="@+id/taskDoneCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:button="@drawable/bb_task_check"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:useMaterialThemeColors="false" />
        <!-- useMaterialThemeColors=false: si no, MaterialCheckBox tiñe todo el layer-list de un
             solo color y el check de la tarea hecha desaparece (disco gris liso). -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_card_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/taskTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BBetter.Body.Medium"
                tools:text="Write 3.1 Methods" />

            <LinearLayout
                android:id="@+id/taskMetaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Progreso de minutos atribuidos "X/Ym" (spec focus-attribution). Sólo visible para
                     tareas con objetivo; lo rellena TodayTaskAdapter desde CalendarEntry.attributedMinutes. -->
                <TextView
                    android:id="@+id/taskProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.BBetter.Micro"
                    android:textColor="@color/bb_primary_bright"
                    android:visibility="gone" />

                <!-- Hora (hoy), fecha (atrasadas) o "Done" (hechas). -->
                <TextView
                    android:id="@+id/taskTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BBetter.Micro" />
            </LinearLayout>
        </LinearLayout>

        <!-- u13: chip de proyecto (join projectId -> Project.name / colorIndex, sin esquema nuevo). -->
        <TextView
            android:id="@+id/taskProjectChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_project_chip"
            android:ellipsize="end"
            android:maxWidth="120dp"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
            android:visibility="gone"
            tools:text="Thesis"
            tools:visibility="visible" />

        <!-- "Focus this" (spec focus-attribution): vincula el timer a esta tarea y arranca la
             sesión. Sólo visible para tareas con objetivo no completadas. -->
        <ImageView
            android:id="@+id/taskFocusButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/task_focus_this_desc"
            android:focusable="true"
            android:padding="@dimen/spacing_xs"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_timer_clock_24"
            android:visibility="gone"
            app:tint="@color/bb_primary_bright" />

        <!-- "Quitar" de una tarea atrasada (spec tasks-recurrence): oculto salvo en la sección de
             atrasadas, donde TodayTaskAdapter recibe un OnTaskRemoveListener. No borra: retira. -->
        <TextView
            android:id="@+id/taskRemoveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/home_overdue_remove_desc"
            android:focusable="true"
            android:padding="@dimen/spacing_xs"
            android:text="@string/home_overdue_remove_symbol"
            android:textAppearance="@style/TextAppearance.BBetter.Label"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
