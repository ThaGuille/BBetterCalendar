<?xml version="1.0" encoding="utf-8"?>
<!-- A wrapping row of option chips (never horizontal scroll). -->
<com.google.android.material.chip.ChipGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:chipSpacingHorizontal="@dimen/projects_picker_gap"
    app:chipSpacingVertical="@dimen/projects_picker_gap" />
