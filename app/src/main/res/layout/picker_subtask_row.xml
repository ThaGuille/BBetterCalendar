<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/projects_picker_row_min"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.example.bbettercalendar.ui.common.widget.TaskCheckView
        android:id="@+id/pickerSubtaskCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:checkSmall="true" />

    <TextView
        android:id="@+id/pickerSubtaskName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.BBetter.Body" />

    <ImageButton
        android:id="@+id/pickerSubtaskRemove"
        android:layout_width="@dimen/projects_picker_row_min"
        android:layout_height="@dimen/projects_picker_row_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_24"
        app:tint="@color/bb_on_surface_muted" />
</LinearLayout>
