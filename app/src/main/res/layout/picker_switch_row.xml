<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/projects_picker_row_min"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/pickerSwitchIcon"
        android:layout_width="@dimen/projects_picker_icon"
        android:layout_height="@dimen/projects_picker_icon"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/pickerSwitchLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/projects_picker_gap"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.BBetter.Body" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/pickerSwitch"
        style="@style/Widget.BBetter.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/projects_picker_gap"
        android:minHeight="@dimen/projects_picker_row_min" />
</LinearLayout>
