<?xml version="1.0" encoding="utf-8"?>
<!-- u21: texto y hint con tokens (antes negro sobre fondo oscuro), botón Widget.BBetter.Button.
     mejora-visual u14: hoja inferior (asa, sin fondo propio: lo pinta Widget.BBetter.BottomSheet),
     botón principal a todo el ancho abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <include layout="@layout/view_sheet_handle" />

    <TextView
        android:id="@+id/popup_description_label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_inner_height"
        android:gravity="center|start"
        android:hint="@string/create_entry_description_hint"
        android:textAppearance="@style/TextAppearance.BBetter.Title"
        android:textColorHint="@color/bb_on_surface_muted" />

    <EditText
        android:id="@+id/popup_description_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:backgroundTint="@color/bb_outline"
        android:gravity="center|start"
        android:importantForAutofill="no"
        android:minHeight="48dp"
        android:textAppearance="@style/TextAppearance.BBetter.Body"
        android:textColorHint="@color/bb_on_surface_muted"
        tools:ignore="LabelFor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/okButton"
        style="@style/Widget.BBetter.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/popup_ok" />

</LinearLayout>
