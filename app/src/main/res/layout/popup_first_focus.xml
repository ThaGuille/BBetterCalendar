<?xml version="1.0" encoding="utf-8"?>
<!-- Celebración del primer pomodoro del día (spec focus-mode-and-streak). La ventana del diálogo
     es transparente (@style/RewardDialog) para que esta tarjeta pueda entrar con escala. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:id="@+id/firstFocusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_floating"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">

        <TextView
            android:id="@+id/firstFocusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/first_focus_badge"
            android:textAppearance="@style/TextAppearance.BBetter.Display"
            android:textSize="@dimen/text_display_compact" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/first_focus_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline"
            android:textColor="@color/bb_on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:text="@string/first_focus_message"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

        <TextView
            android:id="@+id/firstFocusDaysNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.BBetter.Display"
            android:textColor="@color/bb_accent_reward"
            android:textSize="@dimen/text_display_compact"
            tools:text="7" />

        <TextView
            android:id="@+id/firstFocusDaysLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.BBetter.Label"
            tools:text="days with a pomodoro this month" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/firstFocusButton"
            style="@style/Widget.BBetter.Button.Reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/first_focus_button" />

    </LinearLayout>
</FrameLayout>
