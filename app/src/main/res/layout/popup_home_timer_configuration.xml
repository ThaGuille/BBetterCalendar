<?xml version="1.0" encoding="utf-8"?>
<!-- mejora-visual u14: hoja inferior del temporizador. Valores rápidos 25/5, 50/10, 90/15, los
     deslizadores de siempre, ciclos con StepperView y el botón principal abajo. Compacta para que
     quepa sin desplazamiento en 1080x1920 (el scroll solo actúa en pantallas bajas / fuente grande).
     Sin android:background en la raíz: lo pinta Widget.BBetter.BottomSheet. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <include layout="@layout/view_sheet_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_timer_clock_24"
                app:tint="@color/bb_primary_bright" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/timer_popup_title"
                android:textAppearance="@style/TextAppearance.BBetter.Title" />
        </LinearLayout>

        <!-- Quick presets: focus / rest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_25"
                style="@style/Widget.BBetter.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/timer_preset_25"
                android:textAlignment="center" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_50"
                style="@style/Widget.BBetter.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/timer_preset_50"
                android:textAlignment="center" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preset_90"
                style="@style/Widget.BBetter.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/timer_preset_90"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- Concentration tile -->
        <LinearLayout
            android:id="@+id/tile_concentration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_tile_energy"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/timer_concentration_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Body" />

                <TextView
                    android:id="@+id/text_time_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="20:00"
                    android:textAppearance="@style/TextAppearance.BBetter.Title"
                    android:textColor="@color/bb_primary_bright"
                    android:textSize="@dimen/text_stat" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="1"
                android:valueTo="90"
                app:haloColor="@color/bb_primary"
                app:thumbColor="@color/bb_primary"
                app:tickVisible="false"
                app:trackColorActive="@color/bb_primary"
                app:trackColorInactive="@color/bb_divider" />
        </LinearLayout>

        <!-- Rest tile -->
        <LinearLayout
            android:id="@+id/tile_rest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_tile_primary"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/timer_rest_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Body" />

                <TextView
                    android:id="@+id/text_time_resting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:fontFeatureSettings="tnum"
                    android:text="05:00"
                    android:textAppearance="@style/TextAppearance.BBetter.Title"
                    android:textColor="@color/bb_primary_bright"
                    android:textSize="@dimen/text_stat" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_rest_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/timer_rest_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rest_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_rest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="30"
                    app:haloColor="@color/bb_primary"
                    app:thumbColor="@color/bb_primary"
                    app:tickVisible="false"
                    app:trackColorActive="@color/bb_primary"
                    app:trackColorInactive="@color/bb_divider" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cycles: label + infinite pill, then the stepper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/timer_cycles_label"
                android:textAppearance="@style/TextAppearance.BBetter.Body" />

            <ToggleButton
                android:id="@+id/toggle_infinite_cycles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_infinite_pill"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.BBetter.Label"
                android:textColor="@color/bb_on_surface"
                android:textOff="∞ Infinite"
                android:textOn="∞ Infinite" />
        </LinearLayout>

        <com.example.bbettercalendar.ui.common.widget.StepperView
            android:id="@+id/stepper_cycles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:stepperMax="15"
            app:stepperMin="1"
            app:stepperStep="1"
            app:stepperValue="3" />

        <!-- Auto-cycle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_auto_cycle_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_auto_cycle_hint"
                    android:textAppearance="@style/TextAppearance.BBetter.Label" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_auto_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/timer_auto_cycle_label" />
        </LinearLayout>

        <!-- Footer: restore + main button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_restore"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/spacing_md">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_restore_24"
                    app:tint="@color/bb_on_surface_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/timer_btn_restore"
                    android:textAppearance="@style/TextAppearance.BBetter.Label"
                    android:textColor="@color/bb_on_surface_muted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.BBetter.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/timer_btn_save" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
