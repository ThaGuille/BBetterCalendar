<?xml version="1.0" encoding="utf-8"?>
<!-- F2-u8 · Invite sheet: QR on a light plate (also in dark theme), @username and link rows with copy, share as
     text. No background on the root: Widget.BBetter.BottomSheet paints it. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/invite_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/invite_body"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

        <!-- QR / loading / error share one slot so the sheet does not jump when the code arrives. -->
        <FrameLayout
            android:layout_width="@dimen/social_qr_size"
            android:layout_height="@dimen/social_qr_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg">

            <ImageView
                android:id="@+id/inviteQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_social_qr_card"
                android:contentDescription="@string/invite_qr_description"
                android:padding="@dimen/social_qr_padding"
                android:scaleType="fitCenter"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/inviteLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <ProgressBar
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/bb_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/invite_loading"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inviteError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/invite_error"
                    android:textAppearance="@style/TextAppearance.BBetter.SocialError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/inviteRetryButton"
                    style="@style/Widget.BBetter.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/invite_retry" />
            </LinearLayout>
        </FrameLayout>

        <!-- @username -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/social_friend_row_padding"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/invite_handle_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <TextView
                    android:id="@+id/inviteHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                    tools:text="\@alice" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/inviteCopyHandle"
                android:layout_width="@dimen/social_copy_target"
                android:layout_height="@dimen/social_copy_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/invite_copy_handle"
                android:padding="@dimen/spacing_sm"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_content_copy_24"
                app:tint="@color/bb_on_surface_muted" />
        </LinearLayout>

        <!-- Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/social_friend_row_padding"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/invite_link_label"
                    android:textAppearance="@style/TextAppearance.BBetter.Caption" />

                <TextView
                    android:id="@+id/inviteLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                    tools:text="https://bbetter-dbcda.web.app/i/ABCD2345" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/inviteCopyLink"
                android:layout_width="@dimen/social_copy_target"
                android:layout_height="@dimen/social_copy_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/invite_copy_link"
                android:padding="@dimen/spacing_sm"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_content_copy_24"
                app:tint="@color/bb_on_surface_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/inviteShareButton"
            style="@style/Widget.BBetter.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:enabled="false"
            android:text="@string/invite_share" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
