<?xml version="1.0" encoding="utf-8"?>
<!-- F1-u4 · "Únete a tus amigos" sheet (QuickAddTaskSheet pattern). No background on the root:
     Widget.BBetter.BottomSheet paints it. The content scrolls so short screens keep the buttons
     reachable. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <ImageView
            android:layout_width="@dimen/social_hero_tile"
            android:layout_height="@dimen/social_hero_tile"
            android:background="@drawable/bg_social_hero_tile"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="@dimen/social_hero_icon_padding"
            android:src="@drawable/ic_group_add_24"
            android:tint="@color/bb_on_primary_container" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/join_sheet_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/join_sheet_body"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

        <TextView
            android:id="@+id/joinError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.BBetter.SocialError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/joinGoogleButton"
            style="@style/Widget.BBetter.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/join_google" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/joinEmailButton"
            style="@style/Widget.BBetter.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/join_email" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
