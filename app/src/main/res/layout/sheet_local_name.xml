<?xml version="1.0" encoding="utf-8"?>
<!-- F1-u8 · Local-name dialog opened from the Home avatar (QuickAddTaskSheet pattern). No
     background on the root: Widget.BBetter.BottomSheet paints it. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_name_title"
            android:textAppearance="@style/TextAppearance.BBetter.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/local_name_body"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted" />

        <EditText
            android:id="@+id/localNameInput"
            style="@style/Widget.BBetter.Social.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:hint="@string/local_name_hint"
            android:imeOptions="actionDone"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/localNameSave"
            style="@style/Widget.BBetter.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/local_name_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/localNameJoin"
            style="@style/Widget.BBetter.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/local_name_join"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
