<?xml version="1.0" encoding="utf-8"?>
<!-- rediseno-proyectos agenda: short bottom sheet with the dated pending tasks of a project. No background
     on the root: Widget.BBetter.BottomSheet paints it. The handle include has no android:id.
     ConstraintLayout so the list shrinks to the room left (constrainedHeight) and scrolls, while the title
     row with the close button stays visible. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <include
        android:id="@+id/agendaHandleHolder"
        layout="@layout/view_sheet_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/agendaTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/projects_agenda_close_size"
        android:gravity="center_vertical"
        android:text="@string/projects_agenda_title"
        android:textAppearance="@style/TextAppearance.BBetter.Headline"
        app:layout_constraintEnd_toStartOf="@id/agendaClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/agendaHandleHolder" />

    <ImageButton
        android:id="@+id/agendaClose"
        android:layout_width="@dimen/projects_agenda_close_size"
        android:layout_height="@dimen/projects_agenda_close_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/projects_agenda_close"
        android:src="@drawable/ic_close_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/agendaHandleHolder"
        app:tint="@color/bb_on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/agendaTitle"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:id="@+id/agendaList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
