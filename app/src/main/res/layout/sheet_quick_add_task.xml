<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet de alta rápida de tareas desde Home (spec tasks-home-today).
     Título + hora opcional; "More options" abre AddEventActivity precargada.
     u7: sin android:background en la raíz — lo pinta Widget.BBetter.BottomSheet (surface_card,
     esquinas superiores de 24dp); un fondo aquí taparía las esquinas redondeadas. -->
<!-- F0-u2: el contenido va en un NestedScrollView: en pantallas bajas (p. ej. 360x640dp) con el
     teclado abierto la altura natural de la hoja no cabe y los botones se aplastaban. -->
<!-- u3: la hoja no tiene casilla hoy; cualquier casilla nueva usa @style/Widget.BBetter.CheckBox. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <include layout="@layout/view_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quick_add_header"
        android:textAppearance="@style/TextAppearance.BBetter.Title" />

    <EditText
        android:id="@+id/quickAddTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:hint="@string/quick_add_title_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Body"
        android:textColor="@color/bb_on_surface"
        android:textColorHint="@color/bb_on_surface_muted" />

    <!-- u14: atajos de fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/quickAddShortcutToday"
            style="@style/Widget.BBetter.Chip"
            android:checkable="false"
            app:ensureMinTouchTargetSize="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_shortcut_today" />

        <com.google.android.material.chip.Chip
            android:id="@+id/quickAddShortcutTomorrow"
            style="@style/Widget.BBetter.Chip"
            android:checkable="false"
            app:ensureMinTouchTargetSize="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/form_shortcut_tomorrow" />

        <com.google.android.material.chip.Chip
            android:id="@+id/quickAddShortcutPlusHour"
            style="@style/Widget.BBetter.Chip"
            android:checkable="false"
            app:ensureMinTouchTargetSize="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/form_shortcut_plus_hour" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/quickAddTimeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/touch_target_min"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs"
        android:text="@string/quick_add_set_time"
        android:textAppearance="@style/TextAppearance.BBetter.Label"
        android:textColor="@color/bb_primary_bright" />

    <TextView
        android:id="@+id/quickAddRepeatButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/touch_target_min"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs"
        android:text="@string/quick_add_repeat_label"
        android:textAppearance="@style/TextAppearance.BBetter.Label"
        android:textColor="@color/bb_primary_bright" />
    </LinearLayout>

    <!-- Objetivo de minutos de concentración (spec focus-attribution). Opcional; en blanco = 0. -->
    <EditText
        android:id="@+id/quickAddTargetInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:hint="@string/quick_add_target_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Body"
        android:textColor="@color/bb_on_surface"
        android:textColorHint="@color/bb_on_surface_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quickAddMoreOptionsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs"
            android:text="@string/quick_add_more_options"
            android:textAppearance="@style/TextAppearance.BBetter.Label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quickAddSaveButton"
            style="@style/Widget.BBetter.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_add_save" />
    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>
