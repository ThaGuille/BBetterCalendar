<?xml version="1.0" encoding="utf-8"?>
<!-- F2-u7 · Report a person: four predefined reasons (radio buttons), no free text. The send button's
     label says what happens: from the list only a report, from a request the request is declined too. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:id="@+id/reportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.BBetter.Headline"
            tools:text="Report Bob" />

        <TextView
            android:id="@+id/reportBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.BBetter.BodyMuted"
            tools:text="Pick the reason." />

        <RadioGroup
            android:id="@+id/reportReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <RadioButton
                android:id="@+id/reportReasonOffensive"
                style="@style/Widget.BBetter.Social.Radio"
                android:text="@string/report_reason_offensive_name" />

            <RadioButton
                android:id="@+id/reportReasonImpersonation"
                style="@style/Widget.BBetter.Social.Radio"
                android:text="@string/report_reason_impersonation" />

            <RadioButton
                android:id="@+id/reportReasonHarassment"
                style="@style/Widget.BBetter.Social.Radio"
                android:text="@string/report_reason_harassment" />

            <RadioButton
                android:id="@+id/reportReasonOther"
                style="@style/Widget.BBetter.Social.Radio"
                android:text="@string/report_reason_other" />
        </RadioGroup>

        <TextView
            android:id="@+id/reportMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.BBetter.SocialError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportSendButton"
            style="@style/Widget.BBetter.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:enabled="false"
            tools:text="Send report" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
