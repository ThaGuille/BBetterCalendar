<?xml version="1.0" encoding="utf-8"?>
<!-- AppUsageRowView content (mejora-visual u9, mockup 20). Root = horizontal LinearLayout.
     [icon] | Name [lock | Suggested] ... value / usage bar with the limit tick -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/appUsageIcon"
        android:layout_width="@dimen/screen_time_row_icon"
        android:layout_height="@dimen/screen_time_row_icon"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/appUsageName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BBetter.BodyStrong"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/appUsageLockIcon"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Instagram" />

            <ImageView
                android:id="@+id/appUsageLockIcon"
                android:layout_width="@dimen/screen_time_row_lock"
                android:layout_height="@dimen/screen_time_row_lock"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock_24"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/appUsageName"
                app:layout_constraintEnd_toStartOf="@id/appUsageSuggested"
                app:layout_constraintStart_toEndOf="@id/appUsageName"
                app:layout_constraintTop_toTopOf="@id/appUsageName"
                app:tint="@color/bb_primary_bright"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/appUsageSuggested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_progress_suggested_pill"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/screen_time_suggested"
                android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
                android:textColor="@color/bb_accent_reward"
                android:visibility="gone"
                app:layout_constraintBaseline_toBaselineOf="@id/appUsageName"
                app:layout_constraintEnd_toStartOf="@id/appUsageText"
                app:layout_constraintStart_toEndOf="@id/appUsageLockIcon"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/appUsageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.BBetter.Caption"
                app:layout_constraintBaseline_toBaselineOf="@id/appUsageName"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="52 m / 1 h" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.example.bbettercalendar.ui.common.chart.LimitBarView
            android:id="@+id/appUsageBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</merge>
