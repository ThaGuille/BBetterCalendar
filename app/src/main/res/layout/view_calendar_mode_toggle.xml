<?xml version="1.0" encoding="utf-8"?>
<!-- Selector Mes/Semana del calendario (spec frontend-structure-cleanup): sustituye al icono de la
     toolbar, que no se entendía. Mismo segmented track que Día/Semana/Mes de Progress. Cada
     fragment marca su opción con setSelected(true) (Widget.BBetter.SegmentedControl.Item: fondo y texto son selectores).
     OJO: no poner android:id en el <include> — pisaría el id de la raíz. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.BBetter.SegmentedControl"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_md">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/calendarModeMonth"
        style="@style/Widget.BBetter.SegmentedControl.Item"
        android:text="@string/calendar_mode_month" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/calendarModeWeek"
        style="@style/Widget.BBetter.SegmentedControl.Item"
        android:text="@string/calendar_mode_week" />
</LinearLayout>
