<?xml version="1.0" encoding="utf-8"?>
<!-- Fila superior del calendario: selector Mes/Semana (mismo segmented track que Progress; cada fragment
     marca su opción con setSelected(true)) y el botón «Enfoque», que enciende la capa de enfoque
     (rediseno-calendario-color: el calendario abre sin ella).
     OJO: no poner android:id en el <include> — pisaría el id de la raíz. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_sm"
    android:layout_marginEnd="@dimen/spacing_md"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        style="@style/Widget.BBetter.SegmentedControl"
        android:layout_width="0dp"
        android:layout_weight="1">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/calendarModeMonth"
            style="@style/Widget.BBetter.SegmentedControl.Item"
            android:text="@string/calendar_mode_month" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/calendarModeWeek"
            style="@style/Widget.BBetter.SegmentedControl.Item"
            android:text="@string/calendar_mode_week" />
    </LinearLayout>

    <com.google.android.material.chip.Chip
        android:id="@+id/calendarFocusToggle"
        style="@style/Widget.BBetter.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:checkable="true"
        android:text="@string/calendar_legend_focus" />
</LinearLayout>
