<?xml version="1.0" encoding="utf-8"?>
<!-- ExpandStripView content (u3): header row (chevron - title - Ver/Ocultar) and the expanding content. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/expandStripHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
            android:id="@+id/expandStripChevron"
            android:layout_width="@dimen/expand_strip_chevron"
            android:layout_height="@dimen/expand_strip_chevron"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more_24"
            app:tint="@color/bb_on_surface_muted" />

        <TextView
            android:id="@+id/expandStripTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.BBetter.Label"
            tools:text="5 tareas pendientes" />

        <TextView
            android:id="@+id/expandStripAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/widget_strip_show"
            android:textAppearance="@style/TextAppearance.BBetter.Caption"
            android:textColor="@color/bb_primary_bright" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expandStripContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:visibility="gone" />
</merge>
