<?xml version="1.0" encoding="utf-8"?>
<!-- Shell of every task picker (rediseno-proyectos u6): optional header (icon, name, Done) and a
     vertically scrolling content column. Inflated into PickerView (a vertical LinearLayout). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/pickerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/projects_picker_row_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/projects_picker_padding"
        android:paddingEnd="@dimen/projects_picker_gap"
        android:visibility="gone">

        <ImageView
            android:id="@+id/pickerHeaderIcon"
            android:layout_width="@dimen/projects_picker_icon"
            android:layout_height="@dimen/projects_picker_icon"
            android:importantForAccessibility="no"
            app:tint="@color/bb_primary" />

        <TextView
            android:id="@+id/pickerHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/projects_picker_gap"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.BBetter.BodyStrong" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickerHeaderDone"
            style="@style/Widget.BBetter.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/projects_picker_row_min"
            android:text="@string/projects_picker_header_done" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/pickerScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/pickerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/projects_picker_padding" />
    </ScrollView>
</merge>
