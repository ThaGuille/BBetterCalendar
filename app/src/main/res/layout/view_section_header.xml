<?xml version="1.0" encoding="utf-8"?>
<!-- SectionHeaderView content (u9). Root = horizontal LinearLayout, centred vertically.
     [icon] title [NEW] / subtitle ........ meta | action -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/sectionHeaderIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="@color/bb_primary_bright" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sectionHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.BBetter.Title"
                tools:ignore="UnusedAttribute"
                tools:text="Projects this week" />

            <TextView
                android:id="@+id/sectionHeaderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_reward"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textAppearance="@style/TextAppearance.BBetter.Chip"
                android:textColor="@color/bb_on_reward"
                android:visibility="gone"
                tools:text="New" />
        </LinearLayout>

        <TextView
            android:id="@+id/sectionHeaderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.BBetter.Caption"
            android:visibility="gone"
            tools:text="Weekly focus volume" />
    </LinearLayout>

    <TextView
        android:id="@+id/sectionHeaderMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Caption.Semibold"
        android:visibility="gone"
        tools:text="8h 15m logged" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sectionHeaderAction"
        style="@style/Widget.BBetter.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="-8dp"
        android:visibility="gone"
        tools:text="See all" />
</merge>
