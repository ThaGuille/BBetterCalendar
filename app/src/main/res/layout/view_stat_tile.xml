<?xml version="1.0" encoding="utf-8"?>
<!-- StatTileView content (u9). Root = the StatTileView itself (vertical LinearLayout).
     html 13 / 14 / 10 / 02: label · value (+unit) · [bar] · [delta] · [sub]. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/statTileIconStart"
            android:layout_width="@dimen/widget_tile_icon_size"
            android:layout_height="@dimen/widget_tile_icon_size"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statTileLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.Caption"
            tools:text="Focus time" />

        <ImageView
            android:id="@+id/statTileIconEnd"
            android:layout_width="@dimen/widget_tile_icon_size"
            android:layout_height="@dimen/widget_tile_icon_size"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statTileValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.Stat.Tile"
            tools:text="12h 40m" />

        <TextView
            android:id="@+id/statTileUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.Label"
            android:visibility="gone"
            tools:text="m" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/statTileProgress"
        style="@style/Widget.BBetter.LinearProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statTileDelta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="2dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.BBetter.Micro.Bold"
        android:visibility="gone"
        tools:text="14%" />

    <TextView
        android:id="@+id/statTileSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.BBetter.Micro"
        android:visibility="gone"
        tools:text="4.4 / day avg" />
</merge>
