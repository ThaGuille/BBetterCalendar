<?xml version="1.0" encoding="utf-8"?>
<!-- One day of StreakWeekView (u9): dot (check when done / date number) + weekday letter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/streakDayDot"
        android:layout_width="@dimen/widget_streak_dot_size"
        android:layout_height="@dimen/widget_streak_dot_size"
        android:background="@drawable/bg_streak_dot_future">

        <ImageView
            android:id="@+id/streakDayCheck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_24"
            android:visibility="gone"
            app:tint="@color/bb_on_reward" />

        <TextView
            android:id="@+id/streakDayDate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BBetter.Micro"
            android:visibility="gone"
            tools:text="14" />
    </FrameLayout>

    <TextView
        android:id="@+id/streakDayLetter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.BBetter.Micro"
        tools:text="M" />
</LinearLayout>
