<?xml version="1.0" encoding="utf-8"?>
<!-- Focus top bar: Pomodoro settings + block-mode toggle, both as bare icons with a round press ripple
     (action layouts). Icon (per-state drawable) and descriptions of the block one are set by
     FocusFragment.renderBlockMode (3 states). -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/focusSettingsButton"
        android:title="@string/focus_settings_desc"
        app:actionLayout="@layout/view_focus_settings_action"
        app:showAsAction="always" />
    <item
        android:id="@+id/focusBlockModeButton"
        android:title="@string/home_block_mode_off"
        app:actionLayout="@layout/view_focus_block_action"
        app:showAsAction="always" />
</menu>
