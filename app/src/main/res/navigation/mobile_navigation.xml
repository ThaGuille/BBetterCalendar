<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.bbettercalendar.ui.home.HomeFragment"
        android:label=""
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_progress"
        android:name="com.example.bbettercalendar.ui.progress.ProgressFragment"
        android:label="@string/title_progress"
        tools:layout="@layout/fragment_progress" />

    <fragment
        android:id="@+id/navigation_calendar_month"
        android:name="com.example.bbettercalendar.ui.calendar.CalendarFragmentMonth"
        android:label="@string/title_calendar"
        tools:layout="@layout/fragment_calendar_month" >
        <action
            android:id="@+id/action_navigation_calendar_month_to_navigation_calendar_week"
            app:destination="@id/navigation_calendar_week" />
    </fragment>

    <fragment
        android:id="@+id/navigation_calendar_week"
        android:name="com.example.bbettercalendar.ui.calendar.CalendarFragmentWeek"
        android:label="@string/title_calendar"
        tools:layout="@layout/fragment_calendar_week" >
        <action
            android:id="@+id/action_navigation_calendar_week_to_navigation_calendar_month"
            app:destination="@id/navigation_calendar_month" />
    </fragment>

    <fragment
        android:id="@+id/navigation_projects"
        android:name="com.example.bbettercalendar.ui.projects.ProjectsFragment"
        android:label="@string/title_projects"
        tools:layout="@layout/fragment_projects" >
        <action
            android:id="@+id/action_navigation_projects_to_navigation_project_detail"
            app:destination="@id/navigation_project_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_project_detail"
        android:name="com.example.bbettercalendar.ui.projects.ProjectDetailFragment"
        android:label="@string/project_detail_title"
        tools:layout="@layout/fragment_project_detail" >
        <argument
            android:name="projectId"
            app:argType="integer" />
    </fragment>

    <!-- Acción global (spec project-deadlines-progress): alcanzable desde cualquier destino, así
         que las TRES entradas nuevas al detalle de proyecto (deep link de la notificación de
         deadline, tap en el marcador del calendario, tap en una fila de la banda de Progress)
         comparten una sola acción en vez de definir una por destino. La pestaña Projects conserva
         su propia acción. -->
    <action
        android:id="@+id/action_global_project_detail"
        app:destination="@id/navigation_project_detail" />

    <!-- ===== u12: destinos secundarios (sin barra inferior; MainActivity.TOP_LEVEL_DESTINATIONS).
         Se navega a ellos por id de destino (navController.navigate(R.id.navigation_focus)), desde
         cualquier pestaña; system back / la flecha de la barra superior vuelven al origen. ===== -->
    <fragment
        android:id="@+id/navigation_focus"
        android:name="com.example.bbettercalendar.ui.focus.FocusFragment"
        android:label="@string/title_focus"
        tools:layout="@layout/fragment_focus" />

    <fragment
        android:id="@+id/navigation_cycle_complete"
        android:name="com.example.bbettercalendar.ui.focus.CycleCompleteFragment"
        android:label="@string/title_cycle_complete"
        tools:layout="@layout/fragment_cycle_complete" />

    <fragment
        android:id="@+id/navigation_all_progress"
        android:name="com.example.bbettercalendar.ui.progress.AllProgressFragment"
        android:label="@string/title_all_progress"
        tools:layout="@layout/fragment_all_progress" />

    <fragment
        android:id="@+id/navigation_screen_time"
        android:name="com.example.bbettercalendar.ui.screentime.ScreenTimeFragment"
        android:label="@string/title_screen_time"
        tools:layout="@layout/fragment_screen_time" />

    <fragment
        android:id="@+id/navigation_app_detail"
        android:name="com.example.bbettercalendar.ui.screentime.AppDetailFragment"
        android:label="@string/title_app_detail"
        tools:layout="@layout/fragment_app_detail" >
        <!-- AppDetailFragment.ARG_PACKAGE_NAME -->
        <argument
            android:name="packageName"
            app:argType="string" />
    </fragment>

    <!-- ===== F1-u4: entrada social. Se llega por SocialEntryRouter (SocialEntryNavigator), desde
         Focus y Home. Secundarios: sin barra inferior. ===== -->
    <fragment
        android:id="@+id/navigation_age_gate"
        android:name="com.example.bbettercalendar.ui.social.AgeGateFragment"
        android:label="@string/age_gate_top_title"
        tools:layout="@layout/fragment_age_gate" />

    <fragment
        android:id="@+id/navigation_underage"
        android:name="com.example.bbettercalendar.ui.social.UnderageFragment"
        android:label="@string/underage_top_title"
        tools:layout="@layout/fragment_underage" />

    <dialog
        android:id="@+id/navigation_join_friends"
        android:name="com.example.bbettercalendar.ui.social.JoinFriendsSheet"
        tools:layout="@layout/sheet_join_friends">
        <!-- La hoja sale de la pila al pasar al email: atrás vuelve al origen. -->
        <action
            android:id="@+id/action_join_to_email"
            app:destination="@id/navigation_email_sign_in"
            app:popUpTo="@id/navigation_join_friends"
            app:popUpToInclusive="true" />
    </dialog>

    <fragment
        android:id="@+id/navigation_email_sign_in"
        android:name="com.example.bbettercalendar.ui.social.EmailSignInFragment"
        android:label="@string/email_top_title_sign_up"
        tools:layout="@layout/fragment_email_sign_in" />

    <!-- ===== F1-u5: perfil. Crear perfil lo abre el router tras iniciar sesión; termina en Mi perfil. ===== -->
    <fragment
        android:id="@+id/navigation_create_profile"
        android:name="com.example.bbettercalendar.ui.social.CreateProfileFragment"
        android:label="@string/create_profile_top_title"
        tools:layout="@layout/fragment_create_profile" />

    <fragment
        android:id="@+id/navigation_my_profile"
        android:name="com.example.bbettercalendar.ui.social.MyProfileFragment"
        android:label="@string/my_profile_top_title"
        tools:layout="@layout/fragment_my_profile" />
    <!-- ===== F2-u7: Amigos. Lo abren Home, Focus y Mi perfil (SocialEntryNavigator) y, en u8, la campana.
         section=requests (opcional) es lo que ya se ve al entrar; hoy la lista siempre se enseña entera
         y el argumento solo sube hasta las solicitudes. ===== -->
    <fragment
        android:id="@+id/navigation_friends"
        android:name="com.example.bbettercalendar.ui.social.FriendsFragment"
        android:label="@string/friends_top_title"
        tools:layout="@layout/fragment_friends">
        <argument
            android:name="section"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

</navigation>
