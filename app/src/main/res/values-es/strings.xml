    <!-- Aviso de acceso de uso -->
    <string name="usage_disclosure_title">Mide tu uso de apps</string>
    <string name="usage_disclosure_body">Para mostrarte cuánto tiempo pasas en cada app, BBetter lee la información de uso de apps del dispositivo (qué apps se ejecutan en primer plano y durante cuánto tiempo) y la lista de apps instaladas.\n\nTodo se queda en tu dispositivo — nunca se sube, se comparte ni se usa para publicidad. Tú eliges qué apps seguir y puedes desactivarlo cuando quieras en Ajustes → Acceso de uso.</string>
    <string name="usage_disclosure_continue">Continuar</string>
    <string name="usage_disclosure_cancel">Ahora no</string>

    <!-- Aviso de accesibilidad (bloqueo) -->
    <string name="accessibility_disclosure_title">Aplicar límites de apps</string>
    <string name="accessibility_disclosure_body">Para bloquear de verdad una app cuando llega a su límite diario, BBetter usa un servicio de accesibilidad. Solo detecta qué app está en primer plano y tapa las apps que <b>tú</b> has elegido limitar — nunca lee, graba ni envía el contenido de tu pantalla, y todo se queda en este dispositivo.\n\nPuedes desactivarlo cuando quieras en Ajustes → Accesibilidad, o pausar los límites desde la pantalla de Progreso.</string>
    <string name="accessibility_disclosure_steps_title">Después de tocar Activar:</string>
    <string name="accessibility_disclosure_steps">1. Busca <b>BBetter</b> en la lista de servicios\n2. Tócalo y activa el interruptor\n3. Acepta la confirmación del sistema\n4. Vuelve aquí — la app aparecerá como bloqueada</string>
    <string name="accessibility_disclosure_continue">Activar</string>
    <string name="accessibility_disclosure_cancel">Ahora no</string>

    <!-- Descripción del servicio de accesibilidad -->
    <string name="blocker_accessibility_description">Tapa las apps que has elegido limitar cuando superan su tiempo diario. Solo detecta la app en primer plano; nunca lee ni envía el contenido de la pantalla. Todo en el dispositivo.</string>

