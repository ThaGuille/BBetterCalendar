<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================ -->
    <!-- BBetter semantic tokens (dark-first, Stitch «Calm Focus»).    -->
    <!-- Aliases of the primitives in palette.xml — never a raw hex.   -->
    <!-- Prefer these tokens over the legacy color names below.        -->
    <!-- A future light theme only needs values-notnight/colors.xml    -->
    <!-- redefining these names.                                       -->
    <!-- WCAG table: .claude/plans/migracion-visual-stitch-impl.md u4. -->
    <!-- ============================================================ -->

    <!-- Surfaces -->
    <color name="bb_surface">@color/pine_950</color>
    <color name="bb_surface_card">@color/pine_900</color>
    <color name="bb_surface_subtle">@color/pine_800</color>
    <color name="bb_surface_raised">@color/pine_800</color>
    <color name="bb_scrim">@color/pine_950_a60</color>
    <!-- u7: pressed wash on sage/honey fills (pre-multiplied alpha, so it also works in
         framework <ripple> on API 21-22, where a color-state-list android:alpha is ignored). -->
    <color name="bb_ripple_dark">@color/pine_950_a20</color>

    <!-- Brand -->
    <color name="bb_primary">@color/sage_300</color>
    <color name="bb_primary_dark">@color/forest_600</color>
    <color name="bb_on_primary">@color/pine_950</color>
    <color name="bb_primary_container">@color/forest_600</color>
    <color name="bb_on_primary_container">@color/mist_50</color>

    <color name="bb_secondary">@color/dusk_300</color>

    <!-- Reward (Honey Amber: earned moments only) -->
    <color name="bb_accent_reward">@color/honey_300</color>
    <color name="bb_on_reward">@color/pine_950</color>

    <!-- Content on surfaces -->
    <color name="bb_on_surface">@color/mist_50</color>
    <color name="bb_on_surface_muted">@color/lichen_300</color>
    <color name="bb_disabled">@color/mist_50_a38</color>

    <!-- Lines -->
    <color name="bb_divider">@color/pine_700</color>
    <color name="bb_outline">@color/pine_700</color>

    <!-- State & data -->
    <color name="bb_danger">@color/ember_300</color>
    <color name="bb_data_compare">@color/dusk_300</color>

    <!-- Chart washes (u10). Only ChartStyler + the bg_chart_* drawables use them. -->
    <color name="bb_chart_fill_primary_start">@color/sage_300_a32</color>
    <color name="bb_chart_fill_primary_end">@color/sage_300_a00</color>
    <color name="bb_chart_fill_compare_start">@color/dusk_300_a35</color>
    <color name="bb_chart_fill_compare_end">@color/dusk_300_a00</color>
    <color name="bb_chart_band">@color/sage_300_a12</color>
    <color name="bb_chart_halo">@color/honey_300_a25</color>
    <!-- u14 · Focus: halo of the current cycle dot (html ring-2 ring-primary/30). -->
    <color name="bb_focus_dot_ring">@color/sage_300_a32</color>

    <!-- Project accents (ProjectListAdapter.ACCENT_COLORS cycles them by colorIndex).
         Order and hues follow the four project dots of .stitch/html/03-projects.html. -->
    <color name="bb_project_1">@color/sage_300</color>
    <color name="bb_project_2">@color/honey_300</color>
    <color name="bb_project_3">@color/sage_200</color>
    <color name="bb_project_4">@color/seafoam_200</color>

    <!-- Obsolete aliases — kept so old references compile. Removed in u24. -->
    <color name="bb_accent_energy">@color/bb_primary</color>
    <color name="bb_surface_energy_subtle">@color/bb_primary_container</color>

