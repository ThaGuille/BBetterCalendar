<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================ -->
    <!-- BBetter semantic tokens (dark-first, Stitch «Calm Focus»).    -->
    <!-- Values = Stitch namedColors since 2026-10-14 (palette.xml).  -->
    <!-- Aliases of the primitives in palette.xml — never a raw hex.   -->
    <!-- The legacy palette (azul, verde, purple_500, ...) was deleted in u24.        -->
    <!-- A future light theme only needs values-notnight/colors.xml    -->
    <!-- redefining these names.                                       -->
    <!-- WCAG table: .claude/plans/migracion-visual-stitch-impl.md u4. -->
    <!-- ============================================================ -->

    <!-- Surfaces -->
    <color name="bb_surface">@color/pine_950</color>
    <color name="bb_surface_card">@color/pine_900</color>
    <color name="bb_surface_subtle">@color/pine_800</color>
    <color name="bb_surface_raised">@color/pine_800</color>
    <!-- 2026-10-14: the two ends of the Stitch surface-container scale. -->
    <color name="bb_surface_low">@color/pine_925</color>
    <color name="bb_surface_highest">@color/pine_750</color>
    <color name="bb_scrim">@color/pine_950_a60</color>
    <!-- u7: pressed wash on sage/honey fills (pre-multiplied alpha, so it also works in
         framework <ripple> on API 21-22, where a color-state-list android:alpha is ignored). -->
    <color name="bb_ripple_dark">@color/pine_950_a20</color>

    <!-- Brand -->
    <color name="bb_primary">@color/sage_300</color>
    <color name="bb_primary_dark">@color/forest_600</color>
    <!-- Sage FILLS use bb_primary (Stitch primary-container); sage TEXT and ICONS use
         bb_primary_bright (Stitch primary). Content on sage fills: bb_on_primary. -->
    <color name="bb_primary_bright">@color/sage_200</color>
    <color name="bb_on_primary">@color/forest_900</color>
    <color name="bb_primary_container">@color/forest_600</color>
    <color name="bb_on_primary_container">@color/mist_50</color>

    <color name="bb_secondary">@color/dusk_300</color>

    <!-- Reward (Honey Amber: earned moments only) -->
    <color name="bb_accent_reward">@color/honey_300</color>
    <color name="bb_on_reward">@color/pine_950</color>

    <!-- Content on surfaces -->
    <color name="bb_on_surface">@color/mist_50</color>
    <color name="bb_on_surface_muted">@color/lichen_300</color>
    <color name="bb_on_surface_faint">@color/grey_400</color>
    <color name="bb_disabled">@color/mist_50_a38</color>

    <!-- Lines -->
    <color name="bb_divider">@color/outline_v_a30</color>
    <color name="bb_outline">@color/pine_700</color>

    <!-- State & data -->
    <color name="bb_danger">@color/ember_300</color>
    <color name="bb_data_compare">@color/dusk_300</color>

    <!-- Chart washes (u10). Only ChartStyler + the bg_chart_* drawables use them. -->
    <color name="bb_chart_fill_primary_start">@color/sage_300_a32</color>
    <color name="bb_chart_fill_primary_end">@color/sage_300_a00</color>
    <color name="bb_chart_fill_compare_start">@color/dusk_300_a35</color>
    <color name="bb_chart_fill_compare_end">@color/dusk_300_a00</color>
    <color name="bb_chart_band">@color/sage_300_a12</color>
    <color name="bb_chart_halo">@color/honey_300_a25</color>
    <!-- u14 · Focus: halo of the current cycle dot (html ring-2 ring-primary/30). -->
    <color name="bb_focus_dot_ring">@color/sage_300_a32</color>

    <!-- Project accents (ProjectListAdapter.ACCENT_COLORS cycles them by colorIndex).
         Order and hues follow the four project dots of .stitch/html/03-projects.html. -->
    <color name="bb_project_1">@color/sage_300</color>
    <color name="bb_project_2">@color/honey_300</color>
    <color name="bb_project_3">@color/sage_200</color>
    <color name="bb_project_4">@color/seafoam_200</color>

    <!-- F1-u5: the 8 profile avatar colours (profiles/{uid}.avatarColor 0-7, AvatarPalette). Aliases of
         the existing ramps, never hex; initials on them are bb_on_reward (pine_950). -->
    <color name="bb_avatar_0">@color/sage_300</color>
    <color name="bb_avatar_1">@color/sage_200</color>
    <color name="bb_avatar_2">@color/seafoam_200</color>
    <color name="bb_avatar_3">@color/dusk_300</color>
    <color name="bb_avatar_4">@color/honey_300</color>
    <color name="bb_avatar_5">@color/amber_400</color>
    <color name="bb_avatar_6">@color/ember_300</color>
    <color name="bb_avatar_7">@color/sage_500</color>


    <!-- Calendar categorical colors (provisional until the calendar is designed, plan u4):
         aliases of primitives, never hex copies. Text on them is bb_on_primary (pine_950). -->
    <color name="calendar_item_event">@color/dusk_300</color>
    <color name="calendar_item_task">@color/sage_300</color>
    <color name="calendar_item_reminder">@color/honey_300</color>
    <!-- Deadline de proyecto (spec project-deadlines-progress). Antes alias del ámbar de recompensa;
         desde u4 el ámbar es el de los recordatorios y el deadline pasa a ember (plan u4). -->
    <color name="calendar_item_deadline">@color/ember_300</color>

    <!-- «Calm Focus Sanctuary» tokens: ONLY Focus (fragment_focus) and Cycle complete
         (fragment_cycle_complete) use them. Plan paleta-stitch-y-focus-sanctuary.md. -->
    <color name="bb_sanct_surface">@color/sanct_pine_950</color>
    <color name="bb_sanct_card">@color/sanct_pine_900</color>
    <color name="bb_sanct_card_rim">@color/birch_50_a06</color>
    <color name="bb_sanct_track">@color/sanct_pine_850</color>
    <color name="bb_sanct_pill">@color/sanct_pine_800</color>
    <color name="bb_sanct_primary">@color/amber_400</color>
    <color name="bb_sanct_primary_bright">@color/amber_300</color>
    <color name="bb_sanct_on_primary">@color/sanct_pine_ink</color>
    <color name="bb_sanct_sage">@color/sage_300</color>
    <color name="bb_sanct_sage_bright">@color/sage_200</color>
    <color name="bb_sanct_on_surface">@color/birch_50</color>
    <color name="bb_sanct_on_surface_muted">@color/birch_300</color>
    <color name="bb_sanct_on_surface_faint">@color/birch_500</color>
    <color name="bb_sanct_ghost_fill">@color/sanct_pine_900_a60</color>
    <color name="bb_sanct_ghost_rim">@color/sage_300_a30</color>
    <color name="bb_sanct_chip_rim">@color/sage_300_a20</color>
    <color name="bb_sanct_chip_fill">@color/sage_300_a10</color>
    <color name="bb_sanct_divider">@color/sage_300_a15</color>
    <!-- Brillos de la tarjeta del temporizador de Home (html 04: dos manchas difuminadas). -->
    <color name="bb_home_glow_primary_start">@color/sage_200_a08</color>
    <color name="bb_home_glow_primary_end">@color/sage_200_a00</color>
    <color name="bb_home_glow_container_start">@color/forest_600_a60</color>
    <color name="bb_home_glow_container_end">@color/forest_600_a00</color>
    <!-- Avatares de amigos de Cycle complete (html 02: sage-dark / amber-700 / pine-600). -->
    <color name="bb_sanct_avatar_1">@color/sage_500</color>
    <color name="bb_sanct_avatar_2">@color/amber_700</color>
    <color name="bb_sanct_avatar_3">@color/sanct_pine_600</color>
    <color name="bb_sanct_glow_sage">@color/sage_300_a10</color>
    <color name="bb_sanct_button_glow">@color/amber_400_a25</color>
    <color name="bb_sanct_glow_start">@color/amber_400_a18</color>
    <color name="bb_sanct_glow_end">@color/amber_400_a00</color>

</resources>