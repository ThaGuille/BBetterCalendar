<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="cuarenta_y_ocho">56dp</dimen>

    <!-- Spacing scale (u7): 4/8 grid (.stitch/DESIGN.md §5). spacing_lg was 25dp. -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <!-- Gap between stacked cards (DESIGN: 12-16dp between cards). -->
    <dimen name="spacing_card_gap">12dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>
    <dimen name="spacing_xl">36dp</dimen>

    <!-- Form rows -->
    <dimen name="form_row_height">70dp</dimen>
    <dimen name="form_row_icon_size">45dp</dimen>
    <dimen name="form_row_arrow_size">20dp</dimen>
    <dimen name="form_row_inner_height">45dp</dimen>

    <!-- Buttons -->
    <dimen name="icon_button_size">56dp</dimen>
    <dimen name="primary_button_size">128dp</dimen>
    <dimen name="segmented_button_height">36dp</dimen>
    <dimen name="toggle_button_size">30dp</dimen>
    <!-- u7 component sizes (.stitch/DESIGN.md §4 + .stitch/html). -->
    <!-- Full-width pill buttons (Widget.BBetter.Button.*). -->
    <dimen name="button_height">52dp</dimen>
    <!-- Text / danger buttons: touch target only (DESIGN §5: >= 48dp). -->
    <dimen name="button_text_height">48dp</dimen>
    <dimen name="button_padding_horizontal">24dp</dimen>
    <!-- Play / pause circle. -->
    <dimen name="play_button_size">72dp</dimen>
    <!-- Segmented control: track 40dp = 4dp padding + 32dp item (html p-1 / py-2 text-xs). -->
    <dimen name="segmented_track_height">40dp</dimen>
    <dimen name="segmented_track_padding">4dp</dimen>
    <dimen name="chip_min_height">32dp</dimen>
    <dimen name="chip_status_min_height">24dp</dimen>
    <!-- Progress indicators: linear 6dp (html h-1.5), focus ring 7dp (01-focus-running svg). -->
    <dimen name="progress_linear_thickness">6dp</dimen>
    <dimen name="progress_ring_thickness">7dp</dimen>
    <!-- Bottom nav active pill (MD3 indicator 64x32; html px-5 py-1 around a 20px icon). -->
    <dimen name="bottom_nav_indicator_width">64dp</dimen>
    <dimen name="bottom_nav_indicator_height">32dp</dimen>
    <dimen name="bottom_nav_height">72dp</dimen>
    <dimen name="bottom_nav_item_padding_top">12dp</dimen>
    <dimen name="bottom_nav_item_padding_bottom">12dp</dimen>
    <!-- Secondary top bar (u12): html h-14..h-16 → 64dp. -->
    <dimen name="top_bar_height">64dp</dimen>
    <!-- Switch (html 14-screen-time: 48x28 track, 24dp thumb, 2dp inset). -->
    <dimen name="switch_thumb_size">24dp</dimen>
    <dimen name="switch_thumb_size_off">16dp</dimen>
    <dimen name="switch_track_height">28dp</dimen>

    <!-- u9 reusable widgets (ui/common/widget/*View). Values from .stitch/html. -->
    <!-- StatTileView: html p-3.5 / gap-1.5. -->
    <dimen name="widget_tile_padding">14dp</dimen>
    <dimen name="widget_tile_icon_size">16dp</dimen>
    <dimen name="widget_delta_icon_size">16dp</dimen>
    <!-- Small circular icon buttons (period navigator chevrons): 40dp touch. -->
    <dimen name="widget_icon_button_size">40dp</dimen>
    <!-- StreakWeekView: compact dots (html 04 w-4) and the date-number variant. -->
    <dimen name="widget_streak_dot_size">16dp</dimen>
    <dimen name="widget_streak_dot_size_large">28dp</dimen>
    <dimen name="widget_streak_pill_width">48dp</dimen>
    <!-- AvatarView: DESIGN §4 40dp; ring 2dp + 2dp forest gap (html 01 ring-2 p-[2px]). -->
    <dimen name="widget_avatar_size">40dp</dimen>
    <dimen name="widget_avatar_ring">2dp</dimen>
    <dimen name="widget_hairline">1dp</dimen>
    <!-- AppUsageRowView: html 14 w-11 icon, w-20 bar, rounded-[16px] row. -->
    <dimen name="widget_app_icon_size">44dp</dimen>
    <dimen name="widget_app_bar_width">80dp</dimen>
    <dimen name="widget_row_padding">12dp</dimen>
    <!-- StepperView: html 10 w-11 buttons. -->
    <dimen name="widget_stepper_button_size">44dp</dimen>
    <!-- EmptyStateView icon disc. -->
    <dimen name="widget_empty_icon_container">56dp</dimen>
    <dimen name="widget_empty_icon_size">28dp</dimen>

    <!-- Text scale (u6, .stitch/DESIGN.md §3) — mapped by TextAppearance.BBetter.* in
         styles_typography.xml. -->
    <dimen name="text_display">80sp</dimen>
    <!-- Contador del pomodoro compactado para que el timer + lista de tareas de hoy
         quepan sin scroll pesado (spec tasks-home-today). -->
    <dimen name="text_display_compact">44sp</dimen>
    <dimen name="text_stat">28sp</dimen>
    <dimen name="text_headline">22sp</dimen>
    <dimen name="text_title">17sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <!-- 15sp x 1.45 -->
    <dimen name="text_body_line_height">22sp</dimen>
    <dimen name="text_label">13sp</dimen>
    <dimen name="text_chip">12sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <!-- u9: number inside a stat tile (html text-[22px] / text-2xl) and tiny meta (html 10-11px). -->
    <dimen name="text_stat_tile">22sp</dimen>
    <dimen name="text_micro">11sp</dimen>
    <dimen name="text_small">12sp</dimen>
    <dimen name="text_dialog">18sp</dimen>

    <!-- Corner radii (u7). Tailwind in .stitch/html: rounded-lg 8px, rounded-xl 12px,
         rounded-[16px], rounded-[20px] = cards, rounded-full = pills. -->
    <dimen name="radius_sm">8dp</dimen>
    <!-- Was 14dp: inner rows/fields (html rounded-xl = 12px). -->
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_inner">16dp</dimen>
    <!-- Cards (html rounded-[20px] / 01 'card': 20px). -->
    <dimen name="radius_card">20dp</dimen>
    <!-- Dialog windows (rounded_square). -->
    <dimen name="radius_lg">24dp</dimen>
    <!-- Bottom sheets, top corners only. -->
    <dimen name="radius_sheet">24dp</dimen>
    <!-- Any radius >= half the height draws a pill in a <shape>; for MDC shapes use
         ShapeAppearance.BBetter.Pill (50%) instead. -->
    <dimen name="radius_pill">999dp</dimen>

    <!-- Elevations (u7): tonal design, no drop shadows on cards (DESIGN §4). -->
    <dimen name="elevation_card">0dp</dimen>
    <dimen name="elevation_floating">8dp</dimen>
    <!-- The one floating action button per screen keeps a soft shadow (html shadow-lg). -->
    <dimen name="elevation_fab">6dp</dimen>

    <!-- Home screen -->
    <dimen name="home_card_padding">20dp</dimen>
    <dimen name="home_play_button_size">@dimen/play_button_size</dimen>
    <dimen name="home_stat_icon_size">28dp</dimen>
    <!-- Iconos del par fecha / tiempo estudiado del header (spec focus-mode-and-streak) -->
    <dimen name="home_inline_stat_icon_size">16dp</dimen>
    <!-- Botón "cancelar sesión" del focus mode: satélite del play, deliberadamente menor -->
    <dimen name="home_secondary_button_size">48dp</dimen>
    <!-- u13 · Home (html 04) -->
    <dimen name="home_timer_text">72sp</dimen>          <!-- text-7xl hero countdown -->
    <dimen name="home_mode_dot_size">6dp</dimen>        <!-- w-1.5 dot in the mode chip -->
    <dimen name="home_header_icon_button">40dp</dimen>  <!-- bell -->
    <dimen name="home_add_task_button">28dp</dimen>     <!-- w-7 "+" next to Tasks -->
    <dimen name="home_task_check_size">20dp</dimen>     <!-- w-5 round task checkbox -->
    <dimen name="home_friend_avatar_size">32dp</dimen>  <!-- w-8 overlapped avatars -->
    <dimen name="home_friend_avatar_overlap">-8dp</dimen> <!-- -space-x-2 -->
    <dimen name="home_next_up_icon_tile">36dp</dimen>   <!-- w-9 rounded-xl -->
    <!-- u14 · Focus (html 01) -->
    <dimen name="focus_timer_text">74sp</dimen>          <!-- text-[74px] countdown -->
    <dimen name="focus_ring_size">264dp</dimen>          <!-- w-72 box, r=126/140 + 7dp stroke -->
    <dimen name="focus_control_size">56dp</dimen>        <!-- w-14 stop / skip -->
    <dimen name="focus_control_gap">24dp</dimen>         <!-- gap-6 -->
    <dimen name="focus_cycle_dot_box">14dp</dimen>       <!-- w-2.5 dot + 2dp ring each side -->
    <dimen name="focus_cycle_dot_inset">2dp</dimen>
    <dimen name="focus_cycle_dot_gap">4dp</dimen>        <!-- gap-2 minus the ring boxes -->
    <dimen name="focus_friend_avatar_size">44dp</dimen>  <!-- w-11 -->
    <dimen name="focus_icon_button">48dp</dimen>         <!-- w-12 top-bar action -->
    <!-- Celda del calendario de rachas dentro del popup -->
    <dimen name="streak_day_marker_size">30dp</dimen>

    <!-- Fixed positions formerly hardcoded -->
    <dimen name="home_timer_button_margin_bottom">45dp</dimen>
    <dimen name="calendar_fab_margin_bottom">65dp</dimen>

    <!-- Dialog widths -->
    <dimen name="dialog_min_width">240dp</dimen>

    <!-- Progress screen -->
    <!-- Carrusel algo más bajo (era 300dp) para dejar sitio a la banda de uso de Phase 2; la
         pantalla scrollea entera, así que en pantallas pequeñas no se recorta nada. -->
    <dimen name="progress_chart_height">240dp</dimen>
    <!-- u10 ChartStyler: latest-point marker (bg_chart_point_reward): 16dp halo, 10dp dot, 2dp ring. -->
    <dimen name="chart_point_halo">16dp</dimen>
    <dimen name="chart_point_inset">3dp</dimen>
    <dimen name="chart_point_ring">2dp</dimen>
    <!-- Altura mínima del área de la banda de uso (tarjeta LOCKED/EMPTY o lista) para que no quede
         aplastada cuando hay pocas apps. -->
    <dimen name="progress_usage_band_min_height">180dp</dimen>
</resources>
