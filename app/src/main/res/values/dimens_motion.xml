<?xml version="1.0" encoding="utf-8"?>
<!-- Motion and depth dimens (plan mejora-visual u2). -->
<resources>
    <!-- Icon box: 36dp tinted square, 11dp corners, 20dp glyph centred inside. -->
    <dimen name="icon_box_size">36dp</dimen>
    <dimen name="icon_box_radius">11dp</dimen>
    <!-- Light rim on lit cards / icon boxes. -->
    <dimen name="card_lit_rim">1dp</dimen>
    <!-- Halo (radial glow) radius. -->
    <dimen name="glow_radius">96dp</dimen>
    <!-- staggerIn: how far a child travels while it fades in. -->
    <dimen name="motion_stagger_offset">10dp</dimen>
    <!-- Checkbox canvas = touch target (Widget.BBetter.CheckBox draws a 22dp ring inside it). The row
         layouts pull it back by the overhang (48 - 22) / 2 so the ring keeps its old alignment. -->
    <dimen name="checkbox_touch_size">48dp</dimen>
    <dimen name="checkbox_overhang">-13dp</dimen>
    <!-- Segmented control pill slide, shine of the skeleton, ring defaults. -->
    <dimen name="skeleton_radius">8dp</dimen>
    <dimen name="skeleton_row_height">16dp</dimen>
    <dimen name="progress_ring_stroke">8dp</dimen>
    <dimen name="expand_strip_chevron">20dp</dimen>
    <dimen name="expand_strip_radius">16dp</dimen>
</resources>
