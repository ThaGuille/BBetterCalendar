    <string-array name="insight_weekdays_plural">
        <item>Mondays</item>
        <item>Tuesdays</item>
        <item>Wednesdays</item>
        <item>Thursdays</item>
        <item>Fridays</item>
        <item>Saturdays</item>
        <item>Sundays</item>
    </string-array>

    <string name="insight_best_slot">You focus best on %1$s from %2$d to %3$d</string>
    <string name="insight_completion">You complete %1$d%% of your sessions</string>
    <string name="insight_completion_up">You complete %1$d%% of your sessions, %2$d points more than before</string>
    <string name="insight_completion_down">You complete %1$d%% of your sessions, %2$d points fewer than before</string>
