<?xml version="1.0" encoding="utf-8"?>
<!-- mejora-visual u5 · Insight sentences built by stats/InsightPhrases. Each one is shown only when
     there is enough data; the class returns an empty string otherwise (never an invented sentence). -->
<resources>
