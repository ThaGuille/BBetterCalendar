<?xml version="1.0" encoding="utf-8"?>
<!-- Weekly streak (plan racha-semanal-y-constancia): N focus days per week, streak = weeks in a
     row. Used by StreakWeekView, Focus, Cycle complete, Projects and the streak popup. -->
<resources>
    <plurals name="streak_weeks">
        <item quantity="one">%d week</item>
        <item quantity="other">%d weeks</item>
    </plurals>
    <!-- Label when there is no streak yet (0 weeks). -->
    <string name="streak_label_none">Weekly streak</string>
    <!-- This week's days vs the goal ("3/4 days"); quantity = goal. -->
    <plurals name="streak_week_goal">
        <item quantity="one">%1$d/%2$d day</item>
        <item quantity="other">%1$d/%2$d days</item>
    </plurals>
    <string name="streak_week_goal_met" translatable="false">%1$d/%2$d ✓</string>
    <string name="streak_week_goal_desc">%1$d of %2$d focus days this week</string>
    <string name="streak_this_week">%1$d/%2$d this week</string>
    <string name="streak_day_rest">%1$s: rest day</string>

    <!-- Weekly goal picker (FocusStreakPopup). -->
    <string name="streak_goal_title">Weekly goal</string>
    <string name="streak_goal_unit">days / week</string>
    <string name="streak_goal_caption">Each week you hit it, your streak grows</string>
</resources>
