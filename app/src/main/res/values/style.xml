<?xml version="1.0" encoding="utf-8"?>
<resources>

   <style name="CalendarLegendDay">
       <item name="android:layout_width">0dp</item>
       <item name="android:layout_height">wrap_content</item>
       <item name="android:layout_weight">1</item>
       <item name="android:gravity">center</item>
       <item name="android:textColor">@color/bb_on_surface_muted</item>
       <item name="android:textSize">12sp</item>
       <item name="android:textStyle">bold</item>
   </style>

    <!-- Base of the app's custom dialog themes (u5): DayNight dialog + the bb_* colour roles,
         so a dialog looks right even where it is not overlaid on Theme.BBetter. Used with
         android.app.AlertDialog.Builder(ctx, R.style.RoundedDialog) and DialogFragment.setStyle. -->
    <style name="Base.Theme.BBetter.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/bb_primary</item>
        <item name="colorPrimaryVariant">@color/bb_primary_dark</item>
        <item name="colorOnPrimary">@color/bb_on_primary</item>
        <item name="colorSecondary">@color/bb_primary</item>
        <item name="colorOnSecondary">@color/bb_on_primary</item>
        <item name="colorAccent">@color/bb_primary</item>
        <item name="colorSurface">@color/bb_surface_card</item>
        <item name="colorOnSurface">@color/bb_on_surface</item>
        <item name="colorError">@color/bb_danger</item>
        <item name="colorControlNormal">@color/bb_on_surface_muted</item>
        <item name="colorControlActivated">@color/bb_primary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:colorBackground">@color/bb_surface_card</item>
        <!-- u6: sin android:textColor (pisaba el color de los TextAppearance); ver Theme.BBetter. -->
        <item name="android:textViewStyle">@style/Widget.BBetter.TextView</item>
        <item name="android:textColorPrimary">@color/bb_on_surface</item>
        <item name="android:textColorSecondary">@color/bb_on_surface_muted</item>
        <item name="android:textColorHint">@color/bb_on_surface_muted</item>
        <item name="android:textColorPrimaryInverse">@color/bb_on_primary</item>
        <item name="android:datePickerDialogTheme">@style/Theme.BBetter.PickerDialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.BBetter.PickerDialog</item>
        <!-- u7: same shape + component block as Theme.BBetter (keep both in sync). -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BBetter.Pill</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BBetter.Card</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.BBetter.Sheet</item>
        <item name="textAppearanceButton">@style/TextAppearance.BBetter.Button</item>
        <item name="materialButtonStyle">@style/Widget.BBetter.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.BBetter.Button.Secondary</item>
        <item name="materialCardViewStyle">@style/Widget.BBetter.Card</item>
        <item name="floatingActionButtonStyle">@style/Widget.BBetter.FAB</item>
        <item name="chipStyle">@style/Widget.BBetter.Chip</item>
        <item name="switchStyle">@style/Widget.BBetter.Switch</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.BBetter.LinearProgress</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.BBetter.CircularProgress</item>
        <item name="bottomNavigationStyle">@style/Widget.BBetter.BottomNav</item>
        <item name="toolbarStyle">@style/Widget.BBetter.Toolbar</item>
    </style>

    <style name="RoundedDialog" parent="Base.Theme.BBetter.Dialog">
        <!-- Fondo del diálogo con bordes redondeados (rounded_square = bb_surface_card, radio 24). -->
        <item name="android:windowBackground">@drawable/rounded_square</item>
        <!-- Configuraciones opcionales para el padding del diálogo -->
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Reusable building blocks for form rows and icon buttons -->







    <!-- Toggle rows (popup_notifications, popup_repetition) -->



    <!-- Timer configuration popup -->





    <!-- u7: bottom nav indicator moved to styles_components.xml (Widget.BBetter.BottomNav.*). -->

    <!-- Create entry screen: card form rows. (u7: BBetter.SegmentedTrack.Item replaced by
         Widget.BBetter.SegmentedControl.Item in styles_components.xml.) -->
    <style name="BBetter.CardFormRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="BBetter.CardFormRow.Title" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_md</item>
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Body</item>
        <item name="android:textColorHint">@color/bb_on_surface_muted</item>
        <item name="android:background">@null</item>
    </style>

    <style name="BBetter.CardFormRow.Value" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_md</item>
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Body</item>
        <item name="android:textColorHint">@color/bb_on_surface_muted</item>
    </style>

    <!-- Toggle circular de día de la semana en el RepetitionPopup (spec tasks-recurrence). -->
    <style name="BBetter.WeekdayToggle" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/bg_weekday_toggle</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Label</item>
        <item name="android:textColor">@color/weekday_toggle_text</item>
    </style>

    <!-- Diálogo de recompensa (spec focus-mode-and-streak): ventana transparente para que la
         tarjeta pueda entrar con escala + overshoot sin que se vea el rectángulo del diálogo. -->
    <style name="RewardDialog" parent="Base.Theme.BBetter.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

</resources>