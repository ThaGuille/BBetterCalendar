<!-- Projects (mejora-visual u11). -->
<resources>
    <!-- Extended FAB "Nuevo proyecto" (mockup 30): sage pill, pine text and icon, same elevation as the FAB. -->
    <style name="Widget.BBetter.FAB.Extended" parent="Widget.MaterialComponents.ExtendedFloatingActionButton.Icon">
        <item name="android:stateListAnimator">@animator/bb_press</item>
        <item name="backgroundTint">@color/bb_primary</item>
        <item name="iconTint">@color/bb_on_primary</item>
        <item name="android:textColor">@color/bb_on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Button</item>
        <item name="rippleColor">@color/bb_ripple_on_primary</item>
        <item name="elevation">@dimen/elevation_fab</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BBetter.Pill</item>
    </style>

    <!-- rediseno-proyectos: widgets -->

    <!-- rediseno-proyectos: main -->

    <!-- rediseno-proyectos: pickers -->
    <!-- Option chip of the task pickers: 48dp tall, selected on bb_primary_container. -->
    <style name="Widget.BBetter.Chip.Picker">
        <item name="chipMinHeight">@dimen/projects_picker_chip_height</item>
        <item name="chipBackgroundColor">@color/bb_picker_chip_bg</item>
        <item name="chipStrokeColor">@color/bb_picker_chip_stroke</item>
        <item name="android:textColor">@color/bb_picker_chip_text</item>
        <item name="chipIconTint">@null</item>
        <item name="chipIconSize">@dimen/projects_picker_icon</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- Small caps label of a picker section (TIME, REPEAT...). -->
    <style name="TextAppearance.BBetter.PickerLabel" parent="TextAppearance.BBetter.Micro.Bold">
        <item name="android:textColor">@color/bb_on_surface_muted</item>
        <item name="android:textAllCaps">true</item>
    </style>

