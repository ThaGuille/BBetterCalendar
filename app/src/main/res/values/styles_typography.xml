<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================ -->
    <!-- BBetter typography scale (plan migracion-visual-stitch, u6;   -->
    <!-- .stitch/DESIGN.md §3). ONE family: Plus Jakarta Sans, bundled -->
    <!-- as @font/bb_font (res/font/bb_font.xml). No serif.            -->
    <!-- Sizes live in dimens.xml (text_*); this file only maps them.  -->
    <!-- Weights (u9b), every API: 400 = @font/bb_font; 700 = bb_font  -->
    <!-- + textStyle bold (real 700 face); 500 = @font/bb_font_medium;  -->
    <!-- 600 = @font/bb_font_semibold. NEVER android:textFontWeight:    -->
    <!-- AppCompatTextHelper drops it when it re-reads the view attrs.  -->
    <!-- A textStyle="bold" on a 500/600 view selects the real 700 face  -->
    <!-- (bold slot of those families), never synthetic bold.           -->
    <!-- Numbers (Display, Stat) use tabular figures: "tnum".          -->
    <!-- ============================================================ -->

    <style name="TextAppearance.BBetter" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/bb_font</item>
        <item name="fontFamily">@font/bb_font</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- Timer / hero number: 80sp, 700, -1% tracking, tabular figures. -->
    <style name="TextAppearance.BBetter.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- Big stat numbers ("5h 52m", "26 weeks"): 28sp, 700, tabular figures. -->
    <style name="TextAppearance.BBetter.Stat">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- Screen title: 22sp, 700. -->
    <style name="TextAppearance.BBetter.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- Section / card title: 17sp, 700. -->
    <style name="TextAppearance.BBetter.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- Body: 15sp, 400, line height 1.45 (lineHeight is read from the TextAppearance by
         MaterialTextView, i.e. every TextView inflated under Theme.BBetter). -->
    <style name="TextAppearance.BBetter.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="lineHeight">@dimen/text_body_line_height</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- u13b: body with the 500 weight of html text-sm font-medium (Home task titles). -->
    <style name="TextAppearance.BBetter.Body.Medium">
        <item name="android:fontFamily">@font/bb_font_medium</item>
        <item name="fontFamily">@font/bb_font_medium</item>
    </style>

    <style name="TextAppearance.BBetter.BodyMuted" parent="TextAppearance.BBetter.Body">
        <item name="android:textColor">@color/bb_on_surface_muted</item>
    </style>

    <!-- Small label above a number ("Focus time", "Your streak"): 13sp, 500, muted. -->
    <style name="TextAppearance.BBetter.Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">@font/bb_font_medium</item>
        <item name="fontFamily">@font/bb_font_medium</item>
        <item name="android:textColor">@color/bb_on_surface_muted</item>
    </style>

    <!-- Tiny status chip: 12sp, 600, uppercase. Colour = text on an accent fill. -->
    <style name="TextAppearance.BBetter.Chip">
        <item name="android:textSize">@dimen/text_chip</item>
        <item name="android:fontFamily">@font/bb_font_semibold</item>
        <item name="fontFamily">@font/bb_font_semibold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/bb_on_primary</item>
    </style>

    <!-- u7: label of selectable chips and segmented-control items: 12sp, 600, sentence case
         (html text-xs font-semibold). Colour comes from the widget's state list. -->
    <style name="TextAppearance.BBetter.ChipLabel" parent="TextAppearance.BBetter">
        <item name="android:textSize">@dimen/text_chip</item>
        <item name="android:fontFamily">@font/bb_font_semibold</item>
        <item name="fontFamily">@font/bb_font_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- u7: MaterialButton label (theme textAppearanceButton + Widget.BBetter.Button.*): body
         size, 700, sentence case, no tracking. Colour comes from the button's state list. -->
    <style name="TextAppearance.BBetter.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/bb_font</item>
        <item name="fontFamily">@font/bb_font</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Caption / meta (axis labels, "Ends at", list meta): 12sp, 500, muted. -->
    <style name="TextAppearance.BBetter.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/bb_font_medium</item>
        <item name="fontFamily">@font/bb_font_medium</item>
        <item name="android:textColor">@color/bb_on_surface_muted</item>
    </style>

    <!-- u9: number inside a stat tile / compact strip (html text-[20-24px] bold, tabular). -->
    <style name="TextAppearance.BBetter.Stat.Tile">
        <item name="android:textSize">@dimen/text_stat_tile</item>
    </style>

    <!-- u9: list-row title / emphasised body (html text-sm font-bold): body size, 700. -->
    <style name="TextAppearance.BBetter.BodyStrong" parent="TextAppearance.BBetter.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- u9: tiny meta (weekday letters, delta chips, "87% reached"): 11sp, 500, muted, tabular. -->
    <style name="TextAppearance.BBetter.Micro">
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:fontFamily">@font/bb_font_medium</item>
        <item name="fontFamily">@font/bb_font_medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/bb_on_surface_muted</item>
    </style>

    <!-- u9 bold variants (u9b: plain children again, the weight lives in the family).
         Micro.Bold = Micro's medium family + textStyle bold -> its real 700 slot.
         Caption.Semibold = real 600 (it was 700 in u9 as a stop-gap). -->
    <style name="TextAppearance.BBetter.Micro.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BBetter.Caption.Semibold">
        <item name="android:fontFamily">@font/bb_font_semibold</item>
        <item name="fontFamily">@font/bb_font_semibold</item>
    </style>

    <!-- Default for TextViews that set no textAppearance (theme android:textViewStyle). Keeps
         the framework's 14sp "Small" size so legacy screens do not reflow, but in the app font
         and bb_on_surface (the framework default is textColorTertiary). New UI sets a
         TextAppearance.BBetter.* explicitly. -->
    <style name="TextAppearance.BBetter.Default" parent="TextAppearance.AppCompat.Small">
        <item name="android:fontFamily">@font/bb_font</item>
        <item name="fontFamily">@font/bb_font</item>
        <item name="android:textColor">@color/bb_on_surface</item>
    </style>

    <!-- u9b: fontFamily @null on purpose. The theme's fontFamily (bb_font) is the LAST fallback of
         every TextView's own attributes (same trap as android:textColor, u6), so it overrode the
         family of every TextAppearance set in XML: Label/Caption/Chip came out in bb_font 400.
         @null (unlike leaving it unset) stops the lookup before the theme and reads as "no value",
         so the appearance's family wins. Plain TextViews still get bb_font from the Default
         appearance above. Same @null in Widget.BBetter.SegmentedControl.Item (a Button). -->
    <style name="Widget.BBetter.TextView" parent="android:Widget.Material.TextView">
        <item name="android:textAppearance">@style/TextAppearance.BBetter.Default</item>
        <item name="android:fontFamily">@null</item>
        <item name="fontFamily">@null</item>
    </style>

    <!-- u7: component styles (Widget.BBetter.Card & co.) live in styles_components.xml. -->

</resources>
